<!doctype html><html><head><meta charset="utf-8"><style>/**
 * Atelier V2 design system — WP-01.
 *
 * Translated from `docs/design-reference/claude/Atelier App.dc.html` (the
 * resolved design; it implements home direction 1a "La Une, allégée"). Every
 * hex, radius, press depth and duration below is read from that file's inline
 * styles, not invented. The bundled `claude/ref/*.png` are board 0 of the
 * canvas — "Current build, recreated from source" — i.e. the BEFORE. Nothing
 * here is derived from them.
 *
 * The design's own system statement, verbatim:
 *
 *   "two fonts only — Garamond italic for the one headline per screen,
 *    Instrument Sans for everything else, sentence case, no tracked caps.
 *    Rounded 16–24px surfaces instead of ruled boxes. The Bauhaus mark's four
 *    shapes become the app's playful vocabulary: progress tokens, path nodes,
 *    tab icons. One tactile 3D-press button per screen. Red = action, blue =
 *    story/info, yellow = reward, ink = done."
 *
 * ---------------------------------------------------------------------------
 * SCOPING — this file must not change a single legacy pixel while V2 is off.
 * ---------------------------------------------------------------------------
 * Every declaration is either an `@font-face` (see the family-name note in
 * `public/fonts/LICENSE.md`), a `@keyframes`, or scoped under `.av2`. There is
 * no bare element selector, no `:root` token, and no `*` reset. A page that
 * never renders `<AtelierV2Root>` is byte-identical to before.
 *
 * Sizes are in `rem` so the existing Apparence text-size setting
 * (`:root[data-font-size]` in globals.css, 14.5 / 16 / 19px) actually moves
 * this screen. The design's px values are quoted in comments as the source.
 */

/* ===========================================================================
   Fonts — vendored, self-hosted, variable, latin + latin-ext.
   Registered under CSS-local names so legacy surfaces (which ask for
   "EB Garamond" and get Times today) are untouched. See fonts/LICENSE.md.
   =========================================================================== */

@font-face {
  font-family: 'AtelierSerif';
  font-style: italic;
  font-weight: 400 800;
  font-display: swap;
  src: url('file:///Users/vincentpechstein/Downloads/Pixel-lab/ConversationalLanguageLearning/web-frontend/public/fonts/eb-garamond-italic-latin.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
    U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
    U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'AtelierSerif';
  font-style: italic;
  font-weight: 400 800;
  font-display: swap;
  src: url('file:///Users/vincentpechstein/Downloads/Pixel-lab/ConversationalLanguageLearning/web-frontend/public/fonts/eb-garamond-italic-latin-ext.woff2') format('woff2');
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
    U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020,
    U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}

@font-face {
  font-family: 'AtelierSans';
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  src: url('file:///Users/vincentpechstein/Downloads/Pixel-lab/ConversationalLanguageLearning/web-frontend/public/fonts/instrument-sans-latin.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
    U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
    U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'AtelierSans';
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  src: url('file:///Users/vincentpechstein/Downloads/Pixel-lab/ConversationalLanguageLearning/web-frontend/public/fonts/instrument-sans-latin-ext.woff2') format('woff2');
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
    U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020,
    U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}

/* ===========================================================================
   Motion — the design's three keyframes.
   =========================================================================== */

@keyframes av2-pop {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.08); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes av2-rise {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes av2-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===========================================================================
   Tokens — light. Read from the design's inline styles.
   =========================================================================== */

.av2 {
  /* -- Ground ------------------------------------------------------------ */
  --av2-paper: #f1ece1;    /* screen ground, sheet ground */
  --av2-card: #f8f3e8;     /* cards, tiles, chips, input wells */
  --av2-line: #e8e0cf;     /* hairlines, inactive progress track */
  --av2-line-2: #d8cdb6;   /* pressed shadow on paper, sheet handle, dashed lock */

  /* -- Ink --------------------------------------------------------------- */
  --av2-ink: #14110d;      /* text, and the "done" semantic */
  --av2-ink-2: #4a4538;    /* secondary body */
  --av2-muted: #6f6857;    /* labels, meta */

  /* Label colour ON each saturated face. Declared per theme rather than
     patched with extra selectors later: in dark mode the accents become the
     LIGHT end of the scale, so their labels must flip to dark ink. */
  --av2-on-dark: #f8f3e8;  /* generic: text on any saturated or ink surface */
  /* Pure white, not paper-white: the design uses #fff on red in all four of
     its red surfaces, and paper-white measures 4.32:1 there — under AA for the
     17px action label. #fff is 4.78:1. */
  --av2-on-red: #ffffff;
  --av2-on-blue: #f8f3e8;
  --av2-on-green: #f8f3e8;
  --av2-on-yellow: #14110d;
  --av2-on-ink: #f8f3e8;

  /* -- Semantic colour. red = action · blue = story/info · yellow = reward ·
        ink = done · green = correct. Each carries its own press shadow. --- */
  --av2-red: #d8321a;
  --av2-red-deep: #9c2411;
  --av2-blue: #1d3a8a;
  --av2-blue-deep: #14285f;
  --av2-yellow: #f3c318;
  --av2-yellow-deep: #c49a0a;
  --av2-green: #2c6a5d;
  --av2-green-deep: #1f4f45;
  --av2-ink-deep: #000000;

  /* Feedback band tints, straight from the design's `feedbackBg`. */
  --av2-tint-correct: #e3efe9;
  --av2-tint-wrong: #f7e1dc;
  --av2-tint-neutral: var(--av2-paper);

  /* -- Geometry ---------------------------------------------------------- */
  --av2-r-pill: 999px;
  --av2-r-button: 16px;
  --av2-r-card: 16px;
  --av2-r-tile: 18px;
  --av2-r-episode: 22px;
  --av2-r-hero: 24px;
  --av2-r-vocab: 28px;
  --av2-r-sheet: 28px;

  /* -- The 3D press. One primary per composition. ------------------------ */
  --av2-press: 5px;        /* primary action */
  --av2-press-sm: 3px;     /* choice options */
  --av2-press-md: 4px;     /* icon actions, secondary rows */
  --av2-press-lg: 8px;     /* the vocabulary card */
  --av2-press-dur: 0.08s;

  /* -- Type. Design px in comments; rem so the text-size setting moves it. */
  --av2-serif: 'AtelierSerif', 'EB Garamond', Georgia, 'Times New Roman', serif;
  --av2-sans: 'AtelierSans', 'Instrument Sans', system-ui, -apple-system,
    'Segoe UI', Roboto, sans-serif;

  --av2-t-meta: 0.75rem;      /* 12px — labels, meta, tab labels */
  --av2-t-label: 0.8125rem;   /* 13px — chip and tile labels */
  --av2-t-body: 0.9375rem;    /* 15px — chat, card body */
  --av2-t-body-lg: 1rem;      /* 16px — form fields (never below: iOS zoom) */
  --av2-t-action: 1.0625rem;  /* 17px — the primary action label */
  --av2-t-rule: 1.1875rem;    /* 19px — rule-card headline (serif) */
  --av2-t-option: 1.25rem;    /* 20px — choice option (serif) */
  --av2-t-title: 1.5rem;      /* 24px — card headline (serif) */
  --av2-t-head: 1.875rem;     /* 30px — the Séance prompt (serif) */
  --av2-t-screen: 2rem;       /* 32px — the one headline per screen (serif) */
  --av2-t-display: 2.125rem;  /* 34px — date / masthead display (serif) */

  /* -- Layout ------------------------------------------------------------ */
  --av2-gutter: 20px;
  --av2-gap: 12px;
  --av2-tap: 44px;            /* the accessibility floor, never a design value */
  --av2-safe-bottom: max(20px, env(safe-area-inset-bottom));
  --av2-focus: var(--av2-ink);

  /* -- Character accents. The design's `M` avatar uses #2c6a5d, which is the
        serial world bible's --char-marin. Reuse the existing tokens rather
        than opening a parallel set; fall back if globals.css is absent. --- */
  --av2-char-default: var(--char-marchand, #5b5346);
}

/* ---------------------------------------------------------------------------
   Tokens — dark.

   Derived from the design's own hues rather than inverted: the paper darkens
   toward its warm brown rather than to neutral grey, and every accent is
   lifted only until it clears 4.5:1 on the new ground. The *roles* are
   preserved exactly (red = action, blue = story/info, yellow = reward, ink =
   done, green = correct); "ink" simply becomes the light end of the scale, so
   a "done" ink chip stays the highest-contrast thing on the screen.

   Applied by CSS alone — no JS, so there is no hydration mismatch and no
   flash — from the theme attribute `lib/app-preferences.ts` already writes on
   `<html>`, honouring light / dark / system exactly as globals.css does.

   `.av2--dark` forces dark; `.av2--light` opts out of the contextual dark via
   the `:not()` guards below, so it needs no declarations of its own and cannot
   drift from the light block. Both exist for the dev gallery, which has to show
   the two themes side by side on one page whatever the OS is set to.

   ⚠ The two blocks below MUST hold identical declarations. globals.css has
   this same shape and drifted once (its `[data-theme=dark]` block redefined
   tokens the `prefers-color-scheme` block did not, so "system" on a dark OS
   kept light channels). `atelier-v2-ui.test.js` parses this file and fails if
   the two ever diverge.
   --------------------------------------------------------------------------- */

:root[data-theme='dark'] .av2:not(.av2--light),
.av2--dark {
  --av2-paper: #17140f;
  --av2-card: #221e17;
  --av2-line: #332d22;
  --av2-line-2: #4a4234;

  --av2-ink: #f5efe1;
  --av2-ink-2: #d3c8b5;
  --av2-muted: #a2957e;

  --av2-on-dark: #17140f;
  --av2-on-red: #17140f;
  --av2-on-blue: #17140f;
  --av2-on-green: #17140f;
  --av2-on-yellow: #17140f;
  --av2-on-ink: #17140f;

  /* Each accent is the design's hue lifted until it clears 4.5:1 on the new
     ground; each press shadow stays DARKER than its face, so the 3D press
     still reads as depth rather than as a second colour. */
  --av2-red: #ff6a4d;
  --av2-red-deep: #a8321c;
  --av2-blue: #7fa0ff;
  --av2-blue-deep: #3f5cb8;
  --av2-yellow: #f5cc3c;
  --av2-yellow-deep: #b08f16;
  --av2-green: #52b892;
  --av2-green-deep: #2f7a5f;
  /* "ink = done" survives the flip: ink is now the light end of the scale, so
     its press shadow must be a mid tone rather than black. */
  --av2-ink-deep: #6a6152;

  --av2-tint-correct: #1b2d27;
  --av2-tint-wrong: #33201c;
  --av2-tint-neutral: var(--av2-paper);

  --av2-focus: var(--av2-ink);
  --av2-char-default: #8d8371;
}

@media (prefers-color-scheme: dark) {
  :root[data-theme='system'] .av2:not(.av2--light),
  :root:not([data-theme]) .av2:not(.av2--light) {
    --av2-paper: #17140f;
    --av2-card: #221e17;
    --av2-line: #332d22;
    --av2-line-2: #4a4234;

    --av2-ink: #f5efe1;
    --av2-ink-2: #d3c8b5;
    --av2-muted: #a2957e;

    --av2-on-dark: #17140f;
    --av2-on-red: #17140f;
    --av2-on-blue: #17140f;
    --av2-on-green: #17140f;
    --av2-on-yellow: #17140f;
    --av2-on-ink: #17140f;

    /* Each accent is the design's hue lifted until it clears 4.5:1 on the new
       ground; each press shadow stays DARKER than its face, so the 3D press
       still reads as depth rather than as a second colour. */
    --av2-red: #ff6a4d;
    --av2-red-deep: #a8321c;
    --av2-blue: #7fa0ff;
    --av2-blue-deep: #3f5cb8;
    --av2-yellow: #f5cc3c;
    --av2-yellow-deep: #b08f16;
    --av2-green: #52b892;
    --av2-green-deep: #2f7a5f;
    /* "ink = done" survives the flip: ink is now the light end of the scale, so
       its press shadow must be a mid tone rather than black. */
    --av2-ink-deep: #6a6152;

    --av2-tint-correct: #1b2d27;
    --av2-tint-wrong: #33201c;
    --av2-tint-neutral: var(--av2-paper);

    --av2-focus: var(--av2-ink);
    --av2-char-default: #8d8371;
  }
}

/* ===========================================================================
   Root
   =========================================================================== */

.av2 {
  font-family: var(--av2-sans);
  font-weight: 400;
  color: var(--av2-ink);
  background: var(--av2-paper);
  min-width: 0;
  /* Sentence case is a design rule, not a default: undo any inherited
     transform without imposing one on descendants. */
  text-transform: none;
  letter-spacing: normal;
}

.av2 *,
.av2 *::before,
.av2 *::after {
  box-sizing: border-box;
}

/* D-6. Every flex/grid child defaults to `min-width:auto`, which is what let a
   long uppercase word push the primary action off a 320px viewport at 200%
   text. Zero it once, here, for everything this system owns. */
.av2 :where(div, section, header, footer, main, li, p, label, button, a, span) {
  min-width: 0;
}

.av2 :focus-visible {
  outline: 3px solid var(--av2-focus);
  outline-offset: 2px;
  border-radius: 4px;
}

/* A focus ring must not vanish on a saturated face. Offset 2px puts it on the
   paper, so ink reads against every accent; inside an inverted surface the
   ring flips to paper instead. */
.av2 .av2-surface--blue :focus-visible,
.av2 .av2-surface--ink :focus-visible,
.av2 .av2-surface--red :focus-visible {
  --av2-focus: var(--av2-on-dark);
}

@media (prefers-reduced-motion: reduce) {
  .av2 *,
  .av2 *::before,
  .av2 *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

/* ===========================================================================
   Screen scaffold
   =========================================================================== */

.av2 .av2-screen {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  min-width: 0;
  background: var(--av2-paper);
}

.av2 .av2-screen__body {
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--av2-gap);
  padding: 0 var(--av2-gutter);
}

.av2 .av2-screen__foot {
  flex: none;
  padding: 14px var(--av2-gutter) calc(14px + var(--av2-safe-bottom));
  border-top: 1px solid var(--av2-line);
  background: var(--av2-tint-neutral);
  transition: background 0.2s;
}

.av2 .av2-stack {
  display: flex;
  flex-direction: column;
  gap: var(--av2-gap);
  min-width: 0;
}

/* ===========================================================================
   Type
   =========================================================================== */

/* The one Garamond-italic headline per screen. */
.av2 .av2-headline {
  margin: 0;
  font-family: var(--av2-serif);
  font-style: italic;
  font-weight: 500;
  font-size: var(--av2-t-head);
  line-height: 1.15;
  color: var(--av2-ink);
  text-wrap: pretty;
  overflow-wrap: anywhere;
}

.av2 .av2-headline--screen { font-size: var(--av2-t-screen); line-height: 1; }
.av2 .av2-headline--display { font-size: var(--av2-t-display); line-height: 1.05; }
.av2 .av2-headline--title { font-size: var(--av2-t-title); line-height: 1.1; font-weight: 600; }
.av2 .av2-headline--rule { font-size: var(--av2-t-rule); line-height: 1.15; }

/* French content is Garamond italic too — that is the second half of "two
   fonts only", not a third voice. */
.av2 .av2-fr {
  font-family: var(--av2-serif);
  font-style: italic;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.av2 .av2-label {
  margin: 0;
  font-size: var(--av2-t-meta);
  font-weight: 700;
  line-height: 1.3;
  color: var(--av2-muted);
  overflow-wrap: anywhere;
}

.av2 .av2-label--story { color: var(--av2-blue); }
.av2 .av2-label--action { color: var(--av2-red); }

.av2 .av2-body {
  margin: 0;
  font-size: var(--av2-t-label);
  font-weight: 400;
  line-height: 1.45;
  color: var(--av2-ink-2);
  overflow-wrap: anywhere;
}

.av2 .av2-body--lg { font-size: var(--av2-t-body); }

/* ===========================================================================
   Surfaces
   =========================================================================== */

.av2 .av2-surface {
  background: var(--av2-card);
  border-radius: var(--av2-r-card);
  padding: 16px 18px;
  min-width: 0;
  color: var(--av2-ink);
}

.av2 .av2-surface--tile { border-radius: var(--av2-r-tile); padding: 12px 14px; }
.av2 .av2-surface--episode { border-radius: var(--av2-r-episode); padding: 0; overflow: hidden; }
.av2 .av2-surface--hero { border-radius: var(--av2-r-hero); padding: 0; overflow: hidden; }
.av2 .av2-surface--flush { padding: 0; overflow: hidden; }

.av2 .av2-surface--blue { background: var(--av2-blue); color: var(--av2-on-blue); }
.av2 .av2-surface--ink { background: var(--av2-ink); color: var(--av2-on-ink); }
.av2 .av2-surface--red { background: var(--av2-red); color: var(--av2-on-red); }
.av2 .av2-surface--reward { background: var(--av2-yellow); color: var(--av2-on-yellow); }

.av2 .av2-surface--blue .av2-headline,
.av2 .av2-surface--ink .av2-headline,
.av2 .av2-surface--red .av2-headline,
.av2 .av2-surface--blue .av2-label,
.av2 .av2-surface--ink .av2-label,
.av2 .av2-surface--red .av2-label,
.av2 .av2-surface--blue .av2-body,
.av2 .av2-surface--ink .av2-body,
.av2 .av2-surface--red .av2-body {
  color: inherit;
}

/* An outlined surface is the "nothing here yet / locked" state. Dashed rather
   than tinted, so it never reads as an available action. */
.av2 .av2-surface--outline {
  background: transparent;
  border: 2px dashed var(--av2-line-2);
  color: var(--av2-muted);
}

/* ===========================================================================
   The Bauhaus shape vocabulary — progress tokens, path nodes, tab icons.
   =========================================================================== */

.av2 .av2-shape {
  display: inline-block;
  flex: none;
  width: 12px;
  height: 12px;
  background: currentColor;
}

.av2 .av2-shape--square { border-radius: 2px; color: var(--av2-ink); }
.av2 .av2-shape--circle { border-radius: 999px; color: var(--av2-blue); }
.av2 .av2-shape--reward { border-radius: 3px; color: var(--av2-yellow); }
.av2 .av2-shape--triangle {
  border-radius: 0;
  color: var(--av2-red);
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}
.av2 .av2-shape--dot { border-radius: 999px; }
.av2 .av2-shape--sm { width: 8px; height: 8px; }
.av2 .av2-shape--lg { width: 16px; height: 16px; border-radius: 4px; }

.av2 .av2-mark { display: block; flex: none; }

/* WP-D6 (begin): the gender is the shape. Circle = feminine noun, square
   (8 px) = masculine noun, triangle = any other part of speech; the article
   in Garamond italic inside. Colour is the learner state only — yellow new,
   blue learning, ink known — never the gender. Never outlined. A word with no
   stored gender is plain: its initial in ink, no fill, nothing guessed. */
.av2 .av2-word-token {
  display: inline-grid;
  place-items: center;
  flex: none;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--av2-blue);
  color: var(--av2-on-blue);
  font-family: var(--av2-serif);
  font-style: italic;
  font-weight: 500;
  font-size: var(--av2-t-body-lg);
  line-height: 1;
}
.av2 .av2-word-token[data-tone='new'] { background: var(--av2-yellow); color: var(--av2-on-yellow); }
.av2 .av2-word-token[data-tone='known'] { background: var(--av2-ink); color: var(--av2-on-ink); }
.av2 .av2-word-token[data-shape='feminine'] { border-radius: var(--av2-r-pill); }
.av2 .av2-word-token[data-shape='masculine'] { border-radius: 8px; }
.av2 .av2-word-token[data-shape='other'] {
  border-radius: 0;
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}
.av2 .av2-word-token[data-shape='plain'] {
  background: transparent;
  color: var(--av2-ink);
  font-size: var(--av2-t-rule);
}
.av2 .av2-word-token--sm { width: 26px; height: 26px; font-size: var(--av2-t-label); }
.av2 .av2-word-token--sm[data-shape='plain'] { font-size: var(--av2-t-body); }
.av2 .av2-word-token--lg { width: 44px; height: 44px; font-size: var(--av2-t-rule); }
.av2 .av2-word-token--lg[data-shape='plain'] { font-size: var(--av2-t-title); }
.av2 .av2-word-token__article { transform: translateY(-1px); }
/* WP-D6 (end) */

/* ===========================================================================
   Chips / pills
   =========================================================================== */

.av2 .av2-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 32px;
  padding: 4px 12px;
  border: 0;
  border-radius: var(--av2-r-pill);
  background: var(--av2-card);
  color: var(--av2-ink);
  font-family: inherit;
  font-size: var(--av2-t-label);
  font-weight: 700;
  line-height: 1.3;
  text-align: left;
  overflow-wrap: anywhere;
}

.av2 .av2-chip--reward { background: var(--av2-yellow); color: var(--av2-on-yellow); }
.av2 .av2-chip--story { background: var(--av2-blue); color: var(--av2-on-blue); }
.av2 .av2-chip--quiet { background: transparent; color: var(--av2-muted); }

/* An interactive chip is still a control: it gets the tap floor. */
.av2 button.av2-chip,
.av2 a.av2-chip {
  min-height: var(--av2-tap);
  cursor: pointer;
}

/* ===========================================================================
   Buttons — the tactile 3D press
   =========================================================================== */

.av2 .av2-btn {
  --av2-btn-face: var(--av2-card);
  --av2-btn-fg: var(--av2-ink);
  --av2-btn-shadow: var(--av2-line-2);
  --av2-btn-depth: var(--av2-press);

  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  min-height: max(var(--av2-tap), 3.5rem); /* design 56px */
  padding: 0.75rem 1.25rem;
  border: 0;
  border-radius: var(--av2-r-button);
  background: var(--av2-btn-face);
  color: var(--av2-btn-fg);
  box-shadow: 0 var(--av2-btn-depth) 0 var(--av2-btn-shadow);
  font-family: inherit;
  font-size: var(--av2-t-action);
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  transition: transform var(--av2-press-dur), box-shadow var(--av2-press-dur),
    background 0.2s;
  /* The label wraps rather than widening the row — this is the 320px/200% rule. */
  white-space: normal;
  overflow-wrap: anywhere;
  max-width: 100%;
}

.av2 .av2-btn:not(:disabled):not([aria-disabled='true']):active {
  transform: translateY(var(--av2-btn-depth));
  box-shadow: 0 0 0 transparent;
}

.av2 .av2-btn--primary {
  --av2-btn-face: var(--av2-red);
  --av2-btn-fg: var(--av2-on-red);
  --av2-btn-shadow: var(--av2-red-deep);
}

.av2 .av2-btn--done {
  --av2-btn-face: var(--av2-ink);
  --av2-btn-fg: var(--av2-on-ink);
  --av2-btn-shadow: var(--av2-ink-deep);
}

.av2 .av2-btn--story {
  --av2-btn-face: var(--av2-blue);
  --av2-btn-fg: var(--av2-on-blue);
  --av2-btn-shadow: var(--av2-blue-deep);
}

.av2 .av2-btn--reward {
  --av2-btn-face: var(--av2-yellow);
  --av2-btn-fg: var(--av2-on-yellow);
  --av2-btn-shadow: var(--av2-yellow-deep);
}

/* Secondary = paper face on the paper ground, shallower press. */
.av2 .av2-btn--secondary {
  --av2-btn-face: var(--av2-card);
  --av2-btn-fg: var(--av2-ink);
  --av2-btn-shadow: var(--av2-line-2);
  --av2-btn-depth: var(--av2-press-md);
  font-size: var(--av2-t-body-lg);
}
/* On a card the card-coloured face would vanish and leave only its ledge: step to the line tone. */
.av2 .av2-card .av2-btn--secondary,
.av2 .av2-surface .av2-btn--secondary {
  --av2-btn-face: var(--av2-line);
}

/* Quiet = no face, no press. For the third-tier actions (help, stop here) that
   must exist but must never compete with the one primary. */
.av2 .av2-btn--quiet {
  --av2-btn-face: transparent;
  --av2-btn-fg: var(--av2-ink-2);
  --av2-btn-shadow: transparent;
  --av2-btn-depth: 0px;
  min-height: var(--av2-tap);
  padding: 0.5rem 0.75rem;
  font-size: var(--av2-t-label);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.av2 .av2-btn--inline { width: auto; }

/* A disabled control keeps its label fully legible — dim the *face*, never the
   text. `opacity` on the whole button is what makes disabled states unreadable. */
.av2 .av2-btn:disabled,
.av2 .av2-btn[aria-disabled='true'] {
  cursor: not-allowed;
  box-shadow: 0 var(--av2-btn-depth) 0 var(--av2-line);
  background: var(--av2-line);
  color: var(--av2-ink-2);
}

.av2 .av2-btn--quiet:disabled,
.av2 .av2-btn--quiet[aria-disabled='true'] {
  background: transparent;
  box-shadow: none;
  color: var(--av2-muted);
}

/* Pending: the press is spent, the label says so, and a shape token spins only
   when motion is allowed. Status is never colour alone. */
.av2 .av2-btn[data-pending='true'] {
  cursor: progress;
  transform: translateY(var(--av2-btn-depth));
  box-shadow: 0 0 0 transparent;
}

.av2 .av2-btn__spinner {
  flex: none;
  width: 14px;
  height: 14px;
  border-radius: 3px;
  background: currentColor;
  animation: av2-pop 0.9s ease-in-out infinite;
}

/* Icon-only action. 44px floor, round, same press. */
.av2 .av2-icon-btn {
  display: inline-grid;
  place-items: center;
  flex: none;
  width: var(--av2-tap);
  height: var(--av2-tap);
  padding: 0;
  border: 0;
  border-radius: var(--av2-r-pill);
  background: var(--av2-card);
  color: var(--av2-ink);
  cursor: pointer;
  transition: transform var(--av2-press-dur), box-shadow var(--av2-press-dur);
}

.av2 .av2-icon-btn--pressable { box-shadow: 0 var(--av2-press-md) 0 var(--av2-line-2); }
.av2 .av2-icon-btn--pressable:not(:disabled):active {
  transform: translateY(var(--av2-press-md));
  box-shadow: 0 0 0 transparent;
}

.av2 .av2-icon-btn--action {
  background: var(--av2-red);
  color: #fff;
  box-shadow: 0 var(--av2-press-md) 0 var(--av2-red-deep);
}

.av2 .av2-icon-btn--recording {
  background: var(--av2-ink);
  color: var(--av2-on-dark);
  box-shadow: 0 var(--av2-press-md) 0 var(--av2-ink-deep);
}

.av2 .av2-icon-btn:disabled {
  cursor: not-allowed;
  background: var(--av2-line);
  color: var(--av2-ink-2);
  box-shadow: none;
}

/* ===========================================================================
   Progress — blue fill on a line track (design: 14px tall, radius 7)
   =========================================================================== */

.av2 .av2-progress {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.av2 .av2-progress__track {
  flex: 1 1 auto;
  min-width: 0;
  height: 14px;
  border-radius: 7px;
  background: var(--av2-line);
  overflow: hidden;
}

.av2 .av2-progress__fill {
  height: 100%;
  border-radius: 7px;
  background: var(--av2-blue);
  transition: width 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* The segmented variant — one shape token per planned step. This is the
   design's `vocabDots` row, and it is what carries "3 of 5" without a
   fabricated counter: there are exactly as many segments as real plan steps. */
.av2 .av2-progress__segments {
  display: flex;
  flex: 1 1 auto;
  gap: 5px;
  min-width: 0;
}

.av2 .av2-progress__segment {
  flex: 1 1 0;
  min-width: 4px;
  height: 14px;
  border-radius: 7px;
  background: var(--av2-line);
  transition: background 0.3s;
}

.av2 .av2-progress__segment[data-state='done'] { background: var(--av2-ink); }
.av2 .av2-progress__segment[data-state='active'] { background: var(--av2-blue); }
.av2 .av2-progress__segment[data-state='skipped'] { background: var(--av2-line-2); }

.av2 .av2-progress__count {
  flex: none;
  font-size: var(--av2-t-label);
  font-weight: 700;
  color: var(--av2-muted);
}

/* ===========================================================================
   Choice cards — the design's option buttons, with every real state
   =========================================================================== */

.av2 .av2-choices {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.av2 .av2-choice {
  --av2-choice-face: var(--av2-card);
  --av2-choice-edge: var(--av2-line-2);
  --av2-choice-fg: var(--av2-ink);
  --av2-choice-dot: transparent;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  min-height: max(var(--av2-tap), 3.5rem); /* design 56px */
  padding: 0.75rem 1.125rem;
  border: 2px solid var(--av2-choice-edge);
  border-radius: var(--av2-r-button);
  background: var(--av2-choice-face);
  color: var(--av2-choice-fg);
  box-shadow: 0 var(--av2-press-sm) 0 var(--av2-choice-edge);
  font-family: var(--av2-serif);
  font-style: italic;
  font-weight: 500;
  font-size: var(--av2-t-option);
  line-height: 1.3;
  text-align: left;
  cursor: pointer;
  transition: transform var(--av2-press-dur), box-shadow var(--av2-press-dur),
    background 0.15s, border-color 0.15s;
  overflow-wrap: anywhere;
}

.av2 .av2-choice:not(:disabled):active {
  transform: translateY(var(--av2-press-sm));
  box-shadow: 0 0 0 transparent;
}

.av2 .av2-choice[data-state='selected'] {
  --av2-choice-edge: var(--av2-blue);
  --av2-choice-dot: var(--av2-blue);
}

.av2 .av2-choice[data-state='correct'] {
  --av2-choice-face: var(--av2-green);
  --av2-choice-edge: var(--av2-green-deep);
  --av2-choice-fg: var(--av2-on-green);
  --av2-choice-dot: var(--av2-on-green);
}

.av2 .av2-choice[data-state='wrong'] {
  --av2-choice-face: var(--av2-red);
  --av2-choice-edge: var(--av2-red-deep);
  --av2-choice-fg: var(--av2-on-red);
  --av2-choice-dot: var(--av2-on-red);
}

/* Answered options must stay readable after they are disabled. No opacity. */
.av2 .av2-choice:disabled {
  cursor: default;
  color: var(--av2-choice-fg);
  opacity: 1;
}

.av2 .av2-choice__dot {
  flex: none;
  width: 22px;
  height: 22px;
  border-radius: var(--av2-r-pill);
  background: var(--av2-choice-dot);
  display: grid;
  place-items: center;
  color: var(--av2-choice-face);
}

/* ===========================================================================
   Word tiles — the word-bank recall task
   =========================================================================== */

.av2 .av2-tiles { display: flex; flex-direction: column; gap: 10px; min-width: 0; }

.av2 .av2-tiles__line {
  margin: 0;
  min-height: max(var(--av2-tap), 3.25rem);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border-radius: var(--av2-r-card);
  background: var(--av2-card);
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: var(--av2-t-option);
  line-height: 1.3;
  color: var(--av2-ink);
  overflow-wrap: anywhere;
}

.av2 .av2-tiles__line[data-empty='true'] { color: var(--av2-muted); }

.av2 .av2-tiles__bank { display: flex; flex-wrap: wrap; gap: 8px; min-width: 0; }

.av2 .av2-tile {
  display: inline-flex;
  align-items: center;
  min-height: var(--av2-tap);
  padding: 0.5rem 1rem;
  border: 2px solid var(--av2-line-2);
  border-radius: var(--av2-r-pill);
  background: var(--av2-card);
  color: var(--av2-ink);
  box-shadow: 0 var(--av2-press-sm) 0 var(--av2-line-2);
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: var(--av2-t-body);
  line-height: 1.3;
  cursor: pointer;
  transition: transform var(--av2-press-dur), box-shadow var(--av2-press-dur);
  overflow-wrap: anywhere;
  max-width: 100%;
}

.av2 .av2-tile:not(:disabled):active {
  transform: translateY(var(--av2-press-sm));
  box-shadow: 0 0 0 transparent;
}

.av2 .av2-tile[data-state='placed'] {
  border-color: var(--av2-blue);
  box-shadow: 0 var(--av2-press-sm) 0 var(--av2-blue);
}

.av2 .av2-tile:disabled { cursor: default; opacity: 1; color: var(--av2-ink); }

/* ===========================================================================
   Fields
   =========================================================================== */

.av2 .av2-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }

.av2 .av2-field__label {
  font-size: var(--av2-t-meta);
  font-weight: 700;
  color: var(--av2-muted);
}

.av2 .av2-field__control {
  width: 100%;
  min-height: 3rem;
  padding: 0.75rem 1rem;
  border: 2px solid transparent;
  border-radius: var(--av2-r-card);
  background: var(--av2-card);
  color: var(--av2-ink);
  font-family: inherit;
  font-size: var(--av2-t-body-lg); /* never below 16px: iOS zooms the viewport */
  line-height: 1.45;
  resize: vertical;
}

.av2 .av2-field__control::placeholder { color: var(--av2-muted); }
.av2 .av2-field__control:focus { border-color: var(--av2-blue); }
.av2 .av2-field__control:disabled { opacity: 1; color: var(--av2-ink-2); }
.av2 .av2-field__control[aria-invalid='true'] { border-color: var(--av2-red); }

/* The answer once it has been graded. The field stops offering to be used —
   the step is closed — but what the learner actually sent stays legible in the
   same block the field occupied (WP-20 D-6). */
.av2 .av2-field__sent {
  margin: 0;
  width: 100%;
  padding: 0.75rem 1rem;
  border: 2px solid transparent;
  border-radius: var(--av2-r-card);
  background: var(--av2-card);
  color: var(--av2-ink-2);
  font-size: var(--av2-t-body-lg);
  line-height: 1.45;
  overflow-wrap: anywhere;
}

/* The chat-style composer well (Missions). */
.av2 .av2-composer { display: flex; align-items: flex-end; gap: 8px; min-width: 0; }
.av2 .av2-composer .av2-field { flex: 1 1 auto; }

/* ===========================================================================
   Feedback band
   =========================================================================== */

.av2 .av2-feedback {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  min-width: 0;
  animation: av2-pop 0.3s;
}

.av2 .av2-feedback__icon {
  flex: none;
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: var(--av2-r-pill);
  background: var(--av2-muted);
  color: var(--av2-on-dark);
}

.av2 .av2-feedback__title {
  margin: 0;
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: var(--av2-t-option);
  line-height: 1.15;
  color: var(--av2-ink);
  overflow-wrap: anywhere;
}

.av2 .av2-feedback__sub {
  margin: 3px 0 0;
  font-size: var(--av2-t-label);
  line-height: 1.4;
  color: var(--av2-ink-2);
  overflow-wrap: anywhere;
}

.av2 .av2-feedback[data-tone='correct'] .av2-feedback__icon { background: var(--av2-green); }
.av2 .av2-feedback[data-tone='correct'] .av2-feedback__title { color: var(--av2-green); }
.av2 .av2-feedback[data-tone='supported'] .av2-feedback__icon { background: var(--av2-blue); }
.av2 .av2-feedback[data-tone='supported'] .av2-feedback__title { color: var(--av2-blue); }
.av2 .av2-feedback[data-tone='wrong'] .av2-feedback__icon { background: var(--av2-red); }
.av2 .av2-feedback[data-tone='wrong'] .av2-feedback__title { color: var(--av2-red-deep); }

.av2 .av2-screen__foot[data-tone='correct'] { background: var(--av2-tint-correct); }
.av2 .av2-screen__foot[data-tone='wrong'] { background: var(--av2-tint-wrong); }

/* A correction is one line, under the verdict, never a second headline. */
.av2 .av2-correction {
  margin: 10px 0 0;
  padding: 10px 12px;
  border-radius: var(--av2-r-card);
  background: var(--av2-card);
  font-size: var(--av2-t-label);
  line-height: 1.45;
  color: var(--av2-ink-2);
  min-width: 0;
}

.av2 .av2-correction__span { text-decoration: line-through; }
.av2 .av2-correction__fix { font-family: var(--av2-serif); font-style: italic; color: var(--av2-green); }

/* ===========================================================================
   Notices — connection, retry, reconciled, unscored, error.
   Never a verdict: no tint, no tick, always a shape + text.
   =========================================================================== */

.av2 .av2-notice {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  min-width: 0;
  padding: 12px 14px;
  border-radius: var(--av2-r-card);
  background: var(--av2-card);
  color: var(--av2-ink-2);
  font-size: var(--av2-t-label);
  line-height: 1.45;
}

.av2 .av2-notice__body { min-width: 0; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
.av2 .av2-notice p { margin: 0; }
.av2 .av2-notice__mark { flex: none; margin-top: 3px; }

.av2 .av2-notice[data-tone='alert'] { background: var(--av2-tint-wrong); color: var(--av2-ink); }
.av2 .av2-notice[data-tone='quiet'] { background: transparent; border: 2px dashed var(--av2-line-2); }

/* ===========================================================================
   Artwork — decoration that degrades to a shape, never to a broken icon
   =========================================================================== */

.av2 .av2-art {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  background: var(--av2-line);
  min-width: 0;
}

.av2 .av2-art__fallback {
  display: grid;
  place-items: center;
  width: 100%;
  aspect-ratio: 16 / 9;
  background: repeating-linear-gradient(
    135deg,
    var(--av2-line) 0 8px,
    var(--av2-card) 8px 16px
  );
  color: var(--av2-muted);
}

/* ===========================================================================
   Character portrait — keyed to the serial world bible's --char-* tokens
   =========================================================================== */

.av2 .av2-portrait {
  flex: none;
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: var(--av2-r-pill);
  background: var(--av2-char, var(--av2-char-default));
  color: var(--av2-on-dark);
  font-family: var(--av2-serif);
  font-style: italic;
  font-weight: 600;
  font-size: var(--av2-t-rule);
  line-height: 1;
}

.av2 .av2-portrait--sm { width: 22px; height: 22px; font-size: var(--av2-t-meta); }

.av2 .av2-byline { display: flex; align-items: center; gap: 8px; min-width: 0; }

/* ===========================================================================
   Chat bubbles (Missions)
   =========================================================================== */

.av2 .av2-bubble {
  align-self: flex-start;
  max-width: 86%;
  padding: 14px 16px;
  border-radius: 20px 20px 20px 6px;
  background: var(--av2-card);
  color: var(--av2-ink);
  font-size: var(--av2-t-body);
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.av2 .av2-bubble--mine {
  align-self: flex-end;
  border-radius: 20px 20px 6px 20px;
  background: var(--av2-blue);
  color: var(--av2-on-blue);
}

/* ===========================================================================
   Bottom sheet — one handle, scrim, title scale and safe-area rhythm
   =========================================================================== */

.av2 .av2-sheet-layer {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.av2 .av2-sheet__scrim {
  position: absolute;
  inset: 0;
  border: 0;
  padding: 0;
  background: rgba(20, 17, 13, 0.35);
  cursor: pointer;
  animation: av2-fade 0.2s;
}

.av2 .av2-sheet {
  position: relative;
  max-height: 88vh;
  overflow: auto;
  padding: 10px var(--av2-gutter) calc(24px + var(--av2-safe-bottom));
  border-radius: var(--av2-r-sheet) var(--av2-r-sheet) 0 0;
  background: var(--av2-paper);
  color: var(--av2-ink);
  animation: av2-rise 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.av2 .av2-sheet__handle {
  width: 40px;
  height: 5px;
  margin: 0 auto 18px;
  border-radius: 3px;
  background: var(--av2-line-2);
}

.av2 .av2-sheet__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
  min-width: 0;
}

/* A dialog is the same sheet, centred, for a decision that must be answered. */
.av2 .av2-dialog-layer { justify-content: center; padding: var(--av2-gutter); }

.av2 .av2-dialog {
  position: relative;
  width: 100%;
  max-width: 26rem;
  margin: 0 auto;
  padding: 20px;
  border-radius: var(--av2-r-vocab);
  background: var(--av2-paper);
  animation: av2-pop 0.2s;
}

.av2 .av2-dialog__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
  min-width: 0;
}

.av2 .av2-dialog__actions > * { flex: 1 1 10rem; }

/* ===========================================================================
   Tab bar — four French tabs. Hidden on the immersive screens.
   =========================================================================== */

.av2 .av2-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: 8px 12px calc(8px + var(--av2-safe-bottom));
  border-top: 1px solid var(--av2-line);
  background: var(--av2-card);
}

.av2 .av2-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  min-width: 0;
  min-height: var(--av2-tap);
  padding: 8px 0 4px;
  border: 0;
  background: transparent;
  color: var(--av2-muted);
  font-family: inherit;
  font-size: 0.6875rem;
  font-weight: 600;
  line-height: 1.2;
  cursor: pointer;
  overflow-wrap: anywhere;
}

.av2 .av2-tab__pill {
  display: grid;
  place-items: center;
  width: 44px;
  height: 28px;
  border-radius: var(--av2-r-pill);
  background: transparent;
}

.av2 .av2-tab[aria-current='page'] { color: var(--av2-ink); font-weight: 700; }
.av2 .av2-tab[aria-current='page'] .av2-tab__pill { background: var(--av2-line); }

/* ===========================================================================
   Rows / lists (Feuilleton, Cahier)
   =========================================================================== */

.av2 .av2-row {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  width: 100%;
  padding: 12px 14px;
  border: 0;
  border-radius: var(--av2-r-card);
  background: var(--av2-card);
  color: var(--av2-ink);
  font-family: inherit;
  text-align: left;
  min-height: var(--av2-tap);
}

.av2 button.av2-row, .av2 a.av2-row { cursor: pointer; }
.av2 .av2-row__main { flex: 1 1 auto; min-width: 0; }

.av2 .av2-row__badge {
  flex: none;
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  border-radius: 6px;
  background: var(--av2-ink);
  color: var(--av2-on-dark);
}

/* ===========================================================================
   Empty / loading / error blocks
   =========================================================================== */

.av2 .av2-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  min-width: 0;
  padding: 24px 18px;
  border-radius: var(--av2-r-hero);
  background: var(--av2-card);
}

.av2 .av2-state__shapes { display: flex; gap: 6px; }

.av2 .av2-state[data-tone='error'] { background: var(--av2-tint-wrong); }
.av2 .av2-state[data-tone='empty'] { background: transparent; border: 2px dashed var(--av2-line-2); }

.av2 .av2-skeleton {
  border-radius: var(--av2-r-card);
  background: linear-gradient(
    90deg,
    var(--av2-line) 25%,
    var(--av2-card) 37%,
    var(--av2-line) 63%
  );
  background-size: 400% 100%;
  animation: av2-shimmer 1.4s ease infinite;
}

@keyframes av2-shimmer {
  from { background-position: 100% 50%; }
  to { background-position: 0 50%; }
}

/* ===========================================================================
   Visually hidden — for the text half of "never colour alone"
   =========================================================================== */

.av2 .av2-sr {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  border: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  white-space: nowrap;
}

/* ===========================================================================
   Narrow viewport. At 320px the gutter and the gap tighten; nothing is
   allowed to grow a horizontal scrollbar.
   =========================================================================== */

@media (max-width: 360px) {
  .av2 {
    --av2-gutter: 14px;
    --av2-gap: 10px;
  }
  .av2 .av2-dialog__actions > * { flex-basis: 100%; }
}

.av2,
.av2 * { max-width: 100%; }

.av2 img,
.av2 svg { max-width: 100%; }

/* ===========================================================================
   Daily-journey compositions (WP-07 visual).

   Layout only — every colour, radius and press above is already a token. These
   selectors are all inside `.av2`, so they cannot reach a legacy page.
   =========================================================================== */

/* The session shell. `--phone-bottom-nav-space` is the existing app shell's
   own reservation, so the primary action is never behind the tab bar. */
.av2.journey-shell {
  display: block;
  max-width: 720px;
  margin: 0 auto;
  padding: 0 0 calc(24px + var(--phone-bottom-nav-space, 0px));
}

.av2 .av2-screen__body {
  padding-top: 16px;
  padding-bottom: 16px;
  gap: 16px;
}

/* Session header: close control, then the progress rule. The design's streak
   slot on the right is deliberately empty — see the note in JourneySession. */
.av2 .av2-session__head {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  /* WP-19 D-3: this is the topmost element of the journey shell, so on a
     notched device it drew under the status bar and overlapped the clock.
     Same treatment the Épreuve top bar already had (`.ep-top`). */
  padding: calc(12px + env(safe-area-inset-top, 0px)) var(--av2-gutter) 0;
}

.av2 .av2-session__head > .av2-progress {
  flex: 1 1 auto;
  min-width: 0;
}

.av2 .av2-step {
  gap: 14px;
}

/* Help pills, target chips and the text/voice switch all share one wrapping
   row. `flex-wrap` plus the global `min-width:0` is what keeps a long
   translated label from widening the column at 320px / 200% text. */
.av2 .av2-help__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  min-width: 0;
}

.av2 .av2-help {
  gap: 10px;
}

/* A letter is read in full: it has its own padding and wraps, and is never clipped or
   clamped (the episode shape has no padding and hides overflow). */
.av2 .av2-letter {
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow: visible;
  max-width: 100%;
}
.av2 .av2-letter > * {
  overflow: visible;
  overflow-wrap: anywhere;
  white-space: normal;
  text-overflow: clip;
  -webkit-line-clamp: unset;
}

/* The respond row: the primary fills the line, the microphone sits beside it
   and drops below rather than squeezing the action when there is no room. */
.av2 .av2-respond__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.av2 .av2-respond__actions > .av2-btn {
  flex: 1 1 12rem;
  width: auto;
}

.av2 .av2-session__secondary {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  min-width: 0;
}

/* The graded card: verdict band, then the one forward action. */
.av2 .av2-graded {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-width: 0;
  padding: 14px 16px;
  border-radius: var(--av2-r-hero);
  background: var(--av2-tint-neutral);
}

.av2 .av2-graded[data-state='correct'],
.av2 .av2-graded[data-state='supported'] {
  background: var(--av2-tint-correct);
}

.av2 .av2-graded[data-state='wrong'] {
  background: var(--av2-tint-wrong);
}

/* Recap */
.av2 .journey-recap {
  gap: 12px;
}

.av2 .av2-recap__header {
  padding: 16px 18px;
}

.av2 .av2-recap__list {
  list-style: none;
  margin: 8px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
  font-size: var(--av2-t-body);
  line-height: 1.45;
}

.av2 .av2-recap__list li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  min-width: 0;
  overflow-wrap: anywhere;
}

.av2 .av2-recap__list .av2-shape {
  margin-top: 5px;
}

.av2 .av2-recap__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  min-width: 0;
}

.av2 .av2-recap__actions > .av2-btn {
  flex: 1 1 12rem;
  width: auto;
}

/* Today card — the design's episode surface: art flush to the radius, body
   inset below it. */
.av2 .journey-today-card__body {
  padding: 16px 18px 18px;
  gap: 10px;
}

/* WP-109: who is in today's episode — a row of small faces under the headline. */
.av2 .journey-today-card__cast {
  display: flex;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.av2 .journey-today-card .av2-btn {
  margin-top: 4px;
}

.av2 .journey-legacy {
  gap: 8px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.av2 .journey-connection {
  min-width: 0;
}

@media (max-width: 360px) {
  .av2 .av2-respond__actions > .av2-btn,
  .av2 .av2-recap__actions > .av2-btn {
    flex-basis: 100%;
  }
}

/* ===========================================================================
   Home — the design's HOME artboard (direction 1a, "La Une, allégée").
   Masthead row, one episode card, one 3D-press action, three tiles, one
   italic colophon line. Every value is read from the artboard.
   =========================================================================== */

.av2.av2-home {
  /* A column as tall as the screen: WP-81 made Home short, and the embedded tab
     bar must still sit at the bottom rather than float under the plan row. */
  display: flex;
  flex-direction: column;
  min-height: 100dvh;
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 0 0 calc(16px + var(--phone-bottom-nav-space, 0px));
}
.av2.av2-home > .av2-tabbar.embedded { margin-top: auto; position: sticky; bottom: 0; }
.av2.av2-home:has(> .av2-tabbar.embedded) { padding-bottom: 0; }

.av2 .av2-home__mast {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  min-width: 0;
  padding: calc(18px + env(safe-area-inset-top, 0px)) var(--av2-gutter) 0;
}

.av2 .av2-home__mast-main { min-width: 0; }
/* 2026-10-01: Settings in the same corner on every tab (components/layout/ShellCorner.tsx). */
.av2.shell-corner.av2-icon-btn { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 14px); right: 16px; z-index: 5; box-shadow: 0 0 0 1px var(--av2-line); }
/* 2026-10-01: the mark is a button (quick settings); it keeps its look. */
.av2 .av2-home__mark-btn { display: inline-flex; padding: 0; margin: 0; border: 0; background: none; cursor: pointer; border-radius: 12px; }
.av2 .av2-home__mark-btn:focus-visible { outline: 2px solid var(--av2-focus); outline-offset: 3px; }
.av2 .av2-home__kicker { margin: 14px 0 0; font-size: var(--av2-t-label); font-weight: 600; color: var(--av2-muted); }
.av2 .av2-home__date { margin: 3px 0 0; }

/* The streak slot. Rendered only from a real count; otherwise the gear alone. */
.av2 .av2-home__streak {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  min-height: var(--av2-tap);
  min-width: var(--av2-tap); /* the tap floor is a square, not a height */
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--av2-ink);
  font-family: inherit;
  text-align: right;
  cursor: pointer;
}
.av2 .av2-home__streak-n {
  font-family: var(--av2-serif);
  font-style: italic;
  font-weight: 600;
  font-size: 2.875rem; /* 46px */
  line-height: 0.9;
}
.av2 .av2-home__streak-l { font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-muted); }

.av2 .av2-home__section { padding: 14px var(--av2-gutter) 0; min-width: 0; }
.av2 .av2-home__section--first { padding-top: 20px; }
/* WP-81: the one quiet row under the day's plan — at most two chips. */
.av2 .av2-home__chips { display: flex; flex-wrap: wrap; gap: 8px; }
.av2 .av2-home__chips .av2-chip { text-decoration: none; }

/* The episode card is one tap target. */
.av2 .av2-home__episode {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--av2-r-episode);
  background: var(--av2-card);
  color: var(--av2-ink);
  font-family: inherit;
  text-align: left;
  overflow: hidden;
  cursor: pointer;
  transition: transform var(--av2-press-dur);
}
.av2 button.av2-home__episode:not(:disabled):active { transform: scale(0.985); }
.av2 .av2-home__episode-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.av2 .av2-home__episode-body .av2-byline { margin-top: 4px; }
.av2 .av2-home__episode-body .av2-byline .av2-label { color: var(--av2-ink-2); font-weight: 400; font-size: var(--av2-t-label); }

/* Three tiles: Séance · Lexique · Errata */
.av2 .av2-home__tiles {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  padding: 18px var(--av2-gutter) 0;
  min-width: 0;
}

.av2 .av2-day-tile {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
  min-height: var(--av2-tap);
  padding: 14px 12px 12px;
  border: 0;
  border-radius: var(--av2-r-tile);
  background: var(--av2-card);
  color: var(--av2-ink);
  font-family: inherit;
  text-align: left;
  text-decoration: none;
  cursor: pointer;
  transition: transform var(--av2-press-dur);
}
.av2 .av2-day-tile:not(:disabled):active { transform: scale(0.96); }
.av2 .av2-day-tile:disabled { cursor: not-allowed; }
.av2 .av2-day-tile[data-state='done'] { color: var(--av2-muted); }

.av2 .av2-day-tile__mark {
  display: grid;
  place-items: center;
  flex: none;
  width: 26px;
  height: 26px;
  border-radius: 6px;
  background: var(--av2-yellow);
  color: var(--av2-on-ink);
}
.av2 .av2-day-tile__mark--story { border-radius: 999px; background: var(--av2-blue); }
.av2 .av2-day-tile__mark--done { background: var(--av2-ink); }

.av2 .av2-day-tile__title {
  margin: 0;
  font-family: var(--av2-serif);
  font-style: italic;
  font-weight: 400;
  font-size: 1.0625rem; /* 17px */
  line-height: 1;
  color: var(--av2-ink);
}
.av2 .av2-day-tile__meta { margin: 4px 0 0; font-size: var(--av2-t-meta); font-weight: 400; color: var(--av2-muted); line-height: 1.3; }
.av2 .av2-day-tile__bars { display: flex; gap: 3px; width: 100%; margin-top: auto; }
.av2 .av2-day-tile__bars i { flex: 1 1 0; height: 4px; border-radius: 2px; background: var(--av2-line); }
.av2 .av2-day-tile__bars i[data-on='story'] { background: var(--av2-blue); }
.av2 .av2-day-tile__bars i[data-on='reward'] { background: var(--av2-yellow); }
.av2 .av2-day-tile__bars i[data-on='done'] { background: var(--av2-ink); }

/* WP-16 / D-0: the Séance tile's secondary «Plus de pratique» line. The tile
   keeps its own cell height; the link sits under it inside the same grid cell,
   as a sibling so neither control nests inside the other. */
.av2 .av2-day-tile-cell {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}
.av2 .av2-day-tile-cell > .av2-day-tile { flex: 1 1 auto; }
.av2 .av2-day-tile__more {
  display: block;
  width: 100%;
  min-height: var(--av2-tap);
  padding: 6px 4px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: var(--av2-muted);
  font: inherit;
  font-size: var(--av2-t-meta);
  text-align: left;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}
.av2 .av2-day-tile__more:hover { color: var(--av2-ink); }

/* Colophon: "Demain — l’imparfait, épisode 4." */
.av2 .av2-home__foot {
  margin: 22px var(--av2-gutter) 0;
  padding-top: 14px;
  border-top: 1px solid var(--av2-line-2);
  text-align: center;
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: 0.875rem;
  line-height: 1.4;
  color: var(--av2-muted);
}
.av2 .av2-home__foot a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

@media (max-width: 360px) {
  .av2 .av2-home__tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .av2 .av2-day-tile { padding: 12px 10px 10px; }
}

/* ===========================================================================
   App shell — the tab bar as the design draws it. `PhoneProductNav` carries
   the `av2` class itself so the tokens resolve on every page, legacy or not.
   =========================================================================== */

.av2.av2-tabbar {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  min-height: var(--phone-bottom-nav-space, 0px);
  padding: 8px 12px calc(8px + var(--phone-safe-bottom-space, env(safe-area-inset-bottom, 0px)));
  border-top: 1px solid var(--av2-line);
  background: var(--av2-card);
}
.av2.av2-tabbar.fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  display: none;
}
.av2.av2-tabbar.embedded { display: grid; flex: 0 0 auto; }
@media (max-width: 760px) {
  .av2.av2-tabbar.fixed { display: grid; }
}

.av2 .av2-tabbar__tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  min-width: 0;
  min-height: var(--av2-tap);
  padding: 8px 0 4px;
  color: var(--av2-muted);
  font-family: var(--av2-sans);
  font-size: 0.6875rem;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: normal;
  text-transform: none;
  text-decoration: none;
}
.av2 .av2-tabbar__tab span:last-child { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.av2 .av2-tabbar__tab[aria-current='page'] { color: var(--av2-ink); font-weight: 700; }
.av2 .av2-tabbar__tab .av2-tab__pill { color: inherit; }
.av2 .av2-tabbar__tab[aria-current='page'] .av2-tab__pill { background: var(--av2-line); }

.av2 .av2-day-tile__mark--action {
  border-radius: 0;
  background: var(--av2-red);
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}
.av2 .av2-home__mast-main > .av2-mark { display: block; }
.av2 a.av2-icon-btn { text-decoration: none; }
.av2 .av2-home__note { margin: 10px 0 0; }
.av2 .av2-home__section > a.av2-btn--quiet { margin-top: 2px; }
.av2 .av2-home__quote { margin: 6px 0; }

/* ===========================================================================
   Form controls under the system. globals.css forces every input/select/
   textarea into a square 1px ink box with `!important`; inside `.av2` the
   design's rounded card well wins, with the blue focus edge and no glow.
   =========================================================================== */
.av2 input,
.av2 select,
.av2 textarea {
  border-radius: var(--av2-r-card) !important;
  border: 2px solid transparent !important;
  box-shadow: none !important;
  background-color: var(--av2-card);
}
.av2 input:focus,
.av2 select:focus,
.av2 textarea:focus,
.av2 input:focus-visible,
.av2 select:focus-visible,
.av2 textarea:focus-visible {
  box-shadow: none !important;
  outline: 0;
  border-color: var(--av2-blue) !important;
}
.av2 input[aria-invalid='true'],
.av2 textarea[aria-invalid='true'] { border-color: var(--av2-red) !important; }
.av2 input[type='checkbox'],
.av2 input[type='radio'],
.av2 input[type='range'] { border: 0 !important; border-radius: 0 !important; background-color: transparent; }

/* WP-16 / D-0: the «Plus de pratique» strip above the legacy drill loop. */
.av2.atelier-practice-strip {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 12px var(--av2-gutter) 0;
  background: transparent;
}
.av2.atelier-practice-strip p { margin: 0; }
.av2.atelier-practice-strip .av2-headline { margin-top: 2px; }

/* WP-16 / D-0: the recap's inline pointer into the drill loop. A quiet text
   control on the practised line, never a second primary. */
.av2 .av2-recap__practice {
  display: inline;
  padding: 0;
  border: 0;
  background: none;
  color: var(--av2-ink);
  font: inherit;
  font-size: var(--av2-t-meta);
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}
.av2 .av2-recap__practice:hover { color: var(--av2-blue); }

/* ===========================================================================
   Bibliothèque (WP-20) — the imported-books shelf, its texts and its chapter
   sessions, migrated off the legacy `/stories` chrome.

   These are the rules shared by the Bibliothèque components
   (`components/stories/**`, `components/story/UploadBookModal`); the per-screen
   layout lives in each page's own `<style jsx global>` block, the idiom
   `pages/graphic-novel.tsx` uses. Everything below is scoped under `.av2` and
   built only from `--av2-*` tokens.
   =========================================================================== */

.av2 .bib-block { display: flex; flex-direction: column; gap: 10px; }

.av2 .bib-chips { display: flex; flex-wrap: wrap; gap: 6px; }

/* -- Figure tiles. Real server figures only; never a filled-in placeholder. -- */
.av2 .bib-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.av2 .bib-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 12px;
  border-radius: var(--av2-r-tile);
  background: var(--av2-card);
}

/* -- Chapter timeline ------------------------------------------------------
   One node per real chapter. The node's shape and its label carry the state
   together, so colour is never alone. */
.av2 .bib-timeline {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.av2 .bib-timeline__item { display: flex; gap: 12px; align-items: flex-start; }

.av2 .bib-timeline__node {
  flex: none;
  width: 32px;
  height: 32px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.875rem;
  background: var(--av2-line);
  color: var(--av2-ink);
}

.av2 .bib-timeline__item[data-state='done'] .bib-timeline__node {
  background: var(--av2-ink);
  color: var(--av2-on-ink);
}

.av2 .bib-timeline__item[data-state='current'] .bib-timeline__node {
  background: var(--av2-blue);
  color: var(--av2-on-blue);
}

.av2 .bib-timeline__item[data-state='locked'] .bib-timeline__node {
  background: transparent;
  border: 2px dashed var(--av2-line-2);
  color: var(--av2-muted);
}

.av2 .bib-timeline__body { min-width: 0; display: flex; flex-direction: column; gap: 4px; }

.av2 .bib-timeline__item[data-state='locked'] .bib-timeline__body .av2-headline {
  color: var(--av2-muted);
}

/* -- Narrative goals ------------------------------------------------------- */
.av2 .bib-goals {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.av2 .bib-goal { display: flex; gap: 10px; align-items: flex-start; }

.av2 .bib-goal__mark {
  flex: none;
  width: 20px;
  height: 20px;
  margin-top: 2px;
  border-radius: 999px;
  border: 2px solid var(--av2-line-2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.av2 .bib-goal[data-state='done'] .bib-goal__mark {
  background: var(--av2-ink);
  border-color: var(--av2-ink);
  color: var(--av2-on-ink);
}

.av2 .bib-goal__body { min-width: 0; display: flex; flex-direction: column; gap: 2px; }

/* -- Chapter opening narration --------------------------------------------- */
.av2 .bib-narrative { display: flex; flex-direction: column; gap: 6px; }
.av2 .bib-narrative__text { white-space: pre-line; }

/* -- Grammar point --------------------------------------------------------- */
.av2 .bib-grammar__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
  text-align: left;
}

.av2 .bib-grammar__headings { display: flex; flex-direction: column; gap: 2px; min-width: 0; }

.av2 .bib-grammar__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.av2 .bib-grammar__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border-radius: var(--av2-r-tile);
  background: var(--av2-card);
}

.av2 .bib-grammar__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }

/* -- End of a chapter ------------------------------------------------------ */
.av2 .bib-done { display: flex; flex-direction: column; gap: 12px; margin-top: 4px; }

.av2 .bib-done__xp {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  text-align: center;
}

.av2 .bib-done__actions { display: flex; flex-direction: column; gap: 8px; }

/* WP-44 — reader, radio and the Feuilleton season page
   (`docs/design-reference/nouvelles-pages-2026-09-15/`). Everything between
   this comment and the closing one belongs to WP-44; the reader's own rules
   live in `components/feuilleton/reader/reader-styles.tsx`. */

/* -- «Écouter d'abord»: the action lives in a screen foot, not in the flow -- */
.av2 .wp44-radio { min-height: 100%; }

.av2 .wp44-radio__foot {
  position: sticky;
  bottom: 0;
  z-index: 2;
  margin: auto calc(var(--av2-gutter) * -1) 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

/* WP-103 T2 — «Afficher le texte»: the page-wide toggle under the headline, at
   every stage, and the per-line ones beside «Réécouter». Quiet on purpose. */
.av2 .wp44-radio__text { display: flex; }
.av2 .wp44-radio__text .av2-chip[aria-pressed='true'] { background: var(--av2-line); }
.av2 .wp44-radio__line-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0 12px; }
.av2 .wp44-radio__line-actions .av2-btn--inline { width: auto; }

/* -- The season page ------------------------------------------------------ */
.av2 .wp44-season {
  display: flex;
  flex-direction: column;
  gap: var(--av2-gap);
  min-width: 0;
}

.av2 .wp44-season__seg {
  display: flex;
  gap: 4px;
  padding: 4px;
  border-radius: 999px;
  background: transparent;
}

.av2 .wp44-season__seg a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36px;
  padding: 6px 12px;
  border-radius: 999px;
  color: var(--av2-muted);
  font-size: 0.8125rem;
  font-weight: 700;
  text-decoration: none;
}

.av2 .wp44-season__seg a[aria-current='page'] {
  background: var(--av2-card);
  color: var(--av2-ink);
}

/* today's episode — the same «episode» component the artboards use elsewhere:
   radius 22, card ground, art at the head, the story blue for the label and
   for the one button */
.av2 .wp44-today {
  display: flex;
  flex-direction: column;
  border-radius: 22px;
  background: var(--av2-card);
  overflow: hidden;
}

.av2 .wp44-today img {
  display: block;
  width: 100%;
  height: 150px;
  object-fit: cover;
}

.av2 .wp44-today__body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 14px 18px 16px;
}

.av2 .wp44-today__title {
  margin: 0;
  font-family: var(--av2-serif);
  font-style: italic;
  font-weight: 600;
  font-size: 1.5rem;
  line-height: 1.1;
  color: var(--av2-ink);
  text-wrap: pretty;
}

.av2 .wp44-today__action { margin-top: 6px; }

/* the open commitment — dashed, because it is not finished */
.av2 .wp44-commitment {
  padding: 12px 14px;
  border: 2px dashed var(--av2-line-2);
  border-radius: 16px;
}

.av2 .wp44-commitment__label {
  margin: 0 0 4px;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--av2-muted);
}

.av2 .wp44-commitment__text {
  margin: 0;
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: 1.0625rem;
  line-height: 1.35;
  color: var(--av2-ink);
}

.av2 .wp44-commitment__text + .wp44-commitment__text { margin-top: 6px; }

/* WP-63 — the season's long questions, with the state the story put them in */
.av2 .wp44-threads__list {
  list-style: none;
  margin: 6px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.av2 .wp44-threads__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 0;
  border-bottom: 1px solid var(--av2-line-2);
}

.av2 .wp44-threads__row:last-child { border-bottom: 0; }

.av2 .wp44-threads__text {
  font-family: var(--av2-serif);
  font-size: 1rem;
  line-height: 1.35;
  color: var(--av2-ink);
}

.av2 .wp44-threads__state {
  flex: none;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--av2-muted);
}

.av2 .wp44-threads__row[data-thread-state='developing'] .wp44-threads__state { color: var(--av2-ink); }
.av2 .wp44-threads__row[data-thread-state='closed'] .wp44-threads__text { color: var(--av2-muted); }

/* the episodes already read */
.av2 .wp44-read {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.av2 .wp44-read__row {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 10px 12px;
  border: 0;
  border-radius: 16px;
  background: var(--av2-card);
  color: var(--av2-ink);
  text-align: left;
  text-decoration: none;
  cursor: pointer;
}

.av2 .wp44-read__art {
  flex: none;
  width: 56px;
  height: 56px;
  border-radius: 10px;
  object-fit: cover;
  background: var(--av2-tint-neutral);
}

.av2 .wp44-read__text {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.av2 .wp44-read__title {
  font-family: var(--av2-serif);
  font-style: italic;
  font-weight: 500;
  font-size: 1.1875rem;
  line-height: 1.15;
  color: var(--av2-ink);
  overflow-wrap: anywhere;
}

.av2 .wp44-read__meta { font-size: 0.75rem; color: var(--av2-muted); }

.av2 .wp44-read__row svg { flex: 0 0 auto; }
/* end WP-44 */

/* WP-43 — the shell reserves the tab bar; feet sit in the flow.
   ---------------------------------------------------------------------------
   The tab bar is `position: fixed` on phones. Until now each page that knew
   about it padded itself (the session shell, the screen body) and every page
   that did not — placement, répétition, journal — ended under it (WP-39).
   The route shell now reserves the bar's height once, for every page; the two
   in-page reservations below are folded into it (no double air). */
@media (max-width: 760px) {
  .app-route-shell {
    padding-bottom: var(--phone-bottom-nav-space, 0px);
  }
  .app-route-shell .av2.journey-shell {
    padding-bottom: 24px;
  }
  .app-route-shell .av2 .av2-screen__body {
    padding-bottom: 16px;
  }
}

/* The screen foot in the flow (ScreenFoot): hairline, paper, 14px of air, and
   the safe area only when it is really the last thing on the screen. Inside a
   route shell that already reserves the safe area, the foot keeps 14px. */
.av2 .av2-screen__foot--flow {
  flex: none;
  margin-top: auto;
}
@media (max-width: 760px) {
  .app-route-shell .av2 .av2-screen__foot--flow {
    padding-bottom: 14px;
  }
}

/* The feedback launcher must not float over a page's reading column on a
   phone: the Home colophon and the placement body sat under it (WP-39). On
   phone widths it lives in Réglages instead (a row opens the same panel);
   on wider screens it keeps its corner, where nothing flows beneath it. */
@media (max-width: 760px) {
  .av2.fb-scope .fb-launcher {
    display: none;
  }
}
/* end WP-43 */

/* ===========================================================================
   WP-76 / WP-77 — instant feedback and the cast's faces.
   Append-only block; everything is scoped under `.av2` (or is a keyframe).
   =========================================================================== */

@keyframes av2-feel-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-5px); }
  40% { transform: translateX(4px); }
  60% { transform: translateX(-3px); }
  80% { transform: translateX(2px); }
}

@keyframes av2-feel-pop {
  0% { transform: scale(1); }
  45% { transform: scale(1.035); }
  100% { transform: scale(1); }
}

/* A graded pick: a gentle shake when it missed, a small pop when it landed.
   Reduce Motion already collapses every `.av2` animation to nothing. */
.av2 .av2-choice[data-state='wrong'] { animation: av2-feel-shake 0.36s ease-in-out; }
.av2 .av2-choice[data-state='correct'] { animation: av2-feel-pop 0.28s ease-out; }

/* The assembled tile sentence carries the verdict: tint, edge, and a glyph. */
.av2 .av2-tiles__line[data-verdict='correct'] {
  background: var(--av2-tint-correct);
  box-shadow: inset 0 0 0 2px var(--av2-green);
  animation: av2-feel-pop 0.28s ease-out;
}
.av2 .av2-tiles__line[data-verdict='wrong'] {
  background: var(--av2-tint-wrong);
  box-shadow: inset 0 0 0 2px var(--av2-red);
  animation: av2-feel-shake 0.36s ease-in-out;
}
.av2 .av2-tiles__mark {
  flex: none;
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  margin-left: auto;
  border-radius: var(--av2-r-pill);
  background: var(--av2-green);
  color: var(--av2-on-green);
}
.av2 .av2-tiles__line[data-verdict='wrong'] .av2-tiles__mark {
  background: var(--av2-red);
  color: var(--av2-on-red);
}

/* The verdict is a sheet pinned to the bottom of the journey, above the tab
   bar, so it is on screen the moment it lands however long the step is. */
.av2.journey-shell .av2-graded {
  position: sticky;
  bottom: calc(8px + var(--phone-bottom-nav-space, 0px));
  z-index: 4;
  box-shadow: 0 -1px 0 var(--av2-line), 0 10px 28px rgba(20, 17, 13, 0.14);
  animation: av2-rise 0.24s ease-out;
}
.av2.journey-shell .av2-graded:focus { outline: none; }
.av2.journey-shell .av2-graded:focus-visible {
  outline: 2px solid var(--av2-focus);
  outline-offset: 2px;
}

/* The wrong-answer title on the dark ground. `--av2-red-deep` measured 2.30:1
   on the dark wrong tint; the lifted `--av2-red` measures 5.44:1 (6.49:1 on the
   paper). Light mode keeps `--av2-red-deep`. Both dark selectors mirror the
   token blocks above: explicit dark, and "system" on a dark OS. */
:root[data-theme='dark'] .av2:not(.av2--light) .av2-feedback[data-tone='wrong'] .av2-feedback__title,
.av2--dark .av2-feedback[data-tone='wrong'] .av2-feedback__title {
  color: var(--av2-red);
}
@media (prefers-color-scheme: dark) {
  :root[data-theme='system'] .av2:not(.av2--light) .av2-feedback[data-tone='wrong'] .av2-feedback__title,
  :root:not([data-theme]) .av2:not(.av2--light) .av2-feedback[data-tone='wrong'] .av2-feedback__title {
    color: var(--av2-red);
  }
}

/* WP-77 — faces. A portrait disc that has a drawn face shows it edge to edge;
   the small byline disc grows a little so a face is still a face. */
.av2 .av2-portrait[data-face] { overflow: hidden; }
.av2 .av2-portrait[data-face] img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.av2 .av2-portrait--sm[data-face] { width: 28px; height: 28px; }
/* WP-116: a drawn face sits on the card colour, not on the accent disc. */
.av2 .av2-portrait[data-art='drawn'] { background: var(--av2-card); }

/* The character reacting to the verdict: small, at the band's end. */
.av2 .av2-feedback__face { flex: none; margin-left: auto; align-self: center; }

/* A line a character says, with their face beside it. */
.av2 .av2-said { display: flex; align-items: flex-start; gap: 12px; min-width: 0; }
.av2 .av2-said__body {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.av2 .av2-said__body > .av2-label { margin: 0; }

/* The reader: the speaker's face beside the name, the narrator bare. */
.av2 .fr-speaker[data-face='true'] { display: flex; align-items: center; gap: 8px; }
.av2 .fr-bubble .fr-speaker[data-face='true'] { margin-bottom: 4px; }
/* end WP-76 / WP-77 */

/* ===========================================================================
   WP-76 (latency half) — the wait has a face; the reply is read before it is
   judged; the day's scene is prepared in the story, not behind «Envoi…».
   Append-only block, owned by the latency work; scoped under `.av2`.
   =========================================================================== */

.av2 .av2-reply { display: flex; align-items: flex-start; gap: 12px; min-width: 0; }
.av2 .av2-reply__body {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.av2 .av2-reply__body > .av2-label { margin: 0; }
.av2 .av2-reply__text { margin: 0; min-height: 1.4em; }
.av2 .av2-reply__sr {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}
.av2 .av2-reply--typing { align-items: center; }
.av2 .av2-reply__typing {
  margin: 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--av2-muted);
  font-size: var(--av2-t-meta);
}
.av2 .av2-reply__dots { display: inline-flex; gap: 3px; }
.av2 .av2-reply__dots i {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.35;
  animation: av2-reply-dot 1.1s ease-in-out infinite;
}
.av2 .av2-reply__dots i:nth-child(2) { animation-delay: 0.15s; }
.av2 .av2-reply__dots i:nth-child(3) { animation-delay: 0.3s; }

@keyframes av2-reply-dot {
  0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-2px); }
}

/* Today card: the place breathes while the scene is prepared. */
.av2 .journey-today-card--preparing img {
  animation: av2-prep-breathe 2.4s ease-in-out infinite;
}

@keyframes av2-prep-breathe {
  0%, 100% { filter: saturate(1) brightness(1); }
  50% { filter: saturate(1.1) brightness(1.06); }
}

@media (prefers-reduced-motion: reduce) {
  .av2 .av2-reply__dots i,
  .av2 .journey-today-card--preparing img { animation: none; }
  .av2 .av2-reply__dots i { opacity: 0.7; }
}
/* end WP-76 latency */

/* ===========================================================================
   WP-79 — the end of the day, as a reward (JourneyRecap.tsx) and the Home
   streak's «bouclé» mark. Append-only; tokens only, both themes. The one
   motion (the vignette settling) is removed by Reduce Motion with every other
   `.av2` animation.
   =========================================================================== */

.av2 .av2-reward__keepsake {
  margin: 0 0 14px;
  display: grid;
  gap: 8px;
  min-width: 0;
}
.av2 .av2-reward__vignette {
  position: relative;
  overflow: hidden;
  border-radius: var(--av2-r-episode);
  box-shadow: 0 var(--av2-press-md) 0 var(--av2-line);
  aspect-ratio: 16 / 9;
  background: var(--av2-card);
  animation: av2-feel-pop 0.42s ease-out;
}
.av2 .av2-reward__vignette .av2-art,
.av2 .av2-reward__vignette .av2-art__fallback {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 0;
}
.av2 .av2-reward__stamp {
  position: absolute;
  right: 10px;
  bottom: 10px;
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--av2-card);
  box-shadow: 0 var(--av2-press-sm) 0 var(--av2-line);
}
.av2 .av2-reward__caption { display: grid; gap: 2px; min-width: 0; }
.av2 .av2-reward__title {
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: var(--av2-t-rule);
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.av2 .av2-reward__facts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
  gap: 8px;
  margin: 0;
  min-width: 0;
}
.av2 .av2-reward__fact {
  display: grid;
  gap: 2px;
  min-width: 0;
  padding: 10px 12px;
  border-radius: var(--av2-r-tile);
  background: var(--av2-card);
  box-shadow: 0 var(--av2-press-sm) 0 var(--av2-line);
}
.av2 .av2-reward__fact dd { margin: 0; }
.av2 .av2-reward__value {
  font-family: var(--av2-serif);
  font-style: italic;
  font-weight: 600;
  font-size: var(--av2-t-title);
  line-height: 1.1;
  color: var(--av2-ink);
  overflow-wrap: anywhere;
}

.av2 .av2-reward__words {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  min-width: 0;
}
.av2 .av2-reward__word {
  padding: 6px 12px;
  border-radius: var(--av2-r-pill);
  background: var(--av2-card);
  box-shadow: inset 0 0 0 1px var(--av2-line);
  font-size: var(--av2-t-body);
  overflow-wrap: anywhere;
}
.av2 .av2-reward__gloss { color: var(--av2-muted); font-size: var(--av2-t-label); }

.av2 .av2-reward__face {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}
.av2 .av2-reward__face-body { display: grid; gap: 4px; min-width: 0; }
.av2 .av2-reward__face [data-mood='up'] { color: var(--av2-green); }
.av2 .av2-reward__face [data-mood='down'] { color: var(--av2-red); }

.av2 .av2-reward__teaser {
  display: grid;
  gap: 4px;
  padding: 4px 2px 0;
  min-width: 0;
}
.av2 .av2-reward__teaser-line {
  margin: 0;
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: var(--av2-t-rule);
  line-height: 1.3;
  overflow-wrap: anywhere;
}
.av2 .av2-reward__teaser-by {
  font-family: var(--av2-sans);
  font-style: normal;
  font-size: var(--av2-t-meta);
  color: var(--av2-muted);
}

/* Home: the day is done — the streak carries the ink «done» square. */
.av2 .av2-home__streak-l .av2-shape { vertical-align: -1px; margin-right: 4px; }
/* end WP-79 */

/* WP-78 (begin): matching pairs — two columns of cards on the tile spec. */
.av2 .av2-match { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; min-width: 0; }
.av2 .av2-match__col { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.av2 .av2-match__card {
  min-height: var(--av2-tap);
  padding: 0.5rem 0.75rem;
  border: 2px solid var(--av2-line-2);
  border-radius: var(--av2-r-card);
  background: var(--av2-card);
  color: var(--av2-ink);
  box-shadow: 0 var(--av2-press-sm) 0 var(--av2-line-2);
  font-family: var(--av2-serif);
  font-size: var(--av2-t-body);
  line-height: 1.3;
  text-align: center;
  cursor: pointer;
  overflow-wrap: anywhere;
  transition: transform var(--av2-press-dur), box-shadow var(--av2-press-dur),
    background 0.15s, border-color 0.15s, opacity 0.2s;
}
.av2 .av2-match__card[lang='fr'] { font-style: italic; }
.av2 .av2-match__card:not(:disabled):active {
  transform: translateY(var(--av2-press-sm));
  box-shadow: 0 0 0 transparent;
}
.av2 .av2-match__card[data-state='selected'] {
  border-color: var(--av2-blue);
  box-shadow: 0 var(--av2-press-sm) 0 var(--av2-blue);
}
.av2 .av2-match__card[data-state='paired'] { border-color: var(--av2-blue); }
.av2 .av2-match__card[data-state='matched'] {
  background: var(--av2-green);
  border-color: var(--av2-green-deep);
  color: var(--av2-on-green);
  box-shadow: none;
  opacity: 0.55;
}
.av2 .av2-match__card[data-state='wrong'] {
  background: var(--av2-red);
  border-color: var(--av2-red-deep);
  color: var(--av2-on-red);
}
.av2 .av2-match__card:disabled { cursor: default; }
.av2 .av2-listen { width: 100%; }
@media (prefers-reduced-motion: reduce) {
  .av2 .av2-match__card { transition: none; }
}
/* end WP-78 */

/* WP-86 — «Qui a dit ça ?»: three faces in a row, the name under each. */
.av2 .av2-who-said {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
  gap: 10px;
  min-width: 0;
}

.av2 .av2-who-said__card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 12px 8px;
  border: 2px solid var(--av2-line-2);
  border-radius: 16px;
  background: var(--av2-card);
  color: var(--av2-ink);
  box-shadow: 0 3px 0 var(--av2-line-2);
  cursor: pointer;
}

.av2 .av2-who-said__card:disabled {
  cursor: default;
}

.av2 .av2-who-said__card[data-state='selected'] {
  border-color: var(--av2-blue);
}

.av2 .av2-who-said__card[data-state='correct'] {
  border-color: var(--av2-green-deep);
  background: var(--av2-green);
  color: var(--av2-on-green);
}

.av2 .av2-who-said__card[data-state='wrong'] {
  border-color: var(--av2-red-deep);
  background: var(--av2-red);
  color: var(--av2-on-red);
}

.av2 .av2-who-said__name {
  font-weight: 600;
  overflow-wrap: anywhere;
}

/* ===========================================================================
   WP-D1 — the mark is the day's plan; WP-D3 — progress tokens with faces.
   Append-only; tokens only, both themes. A shape that is not done is the same
   solid shape in `--av2-line` — a ghost, never an outline, never a stroke.
   =========================================================================== */

.av2 .av2-mark [data-state] { transition: fill 0.3s; }
.av2 .av2-mark .av2-mark__pop {
  transform-box: fill-box;
  transform-origin: center;
  animation: av2-pop 0.3s ease-out;
}

/* Home: one row of four shape + word labels under the primary. */
.av2 .av2-day-plan {
  /* One row of equal columns, shape above word: four parts fit a 320 px phone without wrapping. */
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(0, 1fr);
  gap: 8px;
  margin: 14px 0 0;
  padding: 0;
  list-style: none;
  font-size: var(--av2-t-label);
  color: var(--av2-muted);
}
.av2 .av2-day-plan__part { display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0; }
.av2 .av2-day-plan__word { display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; }
.av2 .av2-day-plan__part[data-state='todo'] .av2-shape,
.av2 .av2-day-plan__part[data-state='active'] .av2-shape { color: var(--av2-line); }
.av2 .av2-day-plan__part[data-state='active'] { color: var(--av2-ink); font-weight: 700; }
.av2 .av2-day-plan__part[data-state='done'] { color: var(--av2-ink); }

/* Session head: the mark sits in the right-hand slot. */
.av2 .av2-session__head > .av2-mark { margin-left: auto; }

/* The token rail: one shape per step, never wrapping — 8 steps fit at 320px. */
.av2 .av2-token-count { flex: none; font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-muted); font-variant-numeric: tabular-nums; }
.av2 .av2-progress__tokens {
  display: flex;
  flex: 1 1 auto;
  flex-wrap: nowrap;
  align-items: center;
  gap: 5px;
  min-width: 0;
}
.av2 .av2-token {
  display: block;
  flex: 0 1 18px;
  min-width: 10px;
  width: 18px;
  height: auto;
  aspect-ratio: 1;
  overflow: visible;
}
.av2 .av2-token__body { fill: var(--av2-line); transition: fill 0.3s; }
.av2 .av2-token[data-state='skipped'] .av2-token__body { fill: var(--av2-line-2); }
.av2 .av2-token[data-state='done'] .av2-token__body { fill: var(--av2-ink); }
.av2 .av2-token[data-state='active'][data-kind='story'] .av2-token__body { fill: var(--av2-blue); }
.av2 .av2-token[data-state='active'][data-kind='reward'] .av2-token__body { fill: var(--av2-yellow); }
.av2 .av2-token[data-state='active'][data-kind='action'] .av2-token__body { fill: var(--av2-red); }
.av2 .av2-token[data-state='active'][data-kind='done'] .av2-token__body { fill: var(--av2-ink); }
.av2 .av2-token[data-state='active'] { animation: av2-pop 0.3s ease-out; }

/* Eyes and mouth only — ReactForm's face, without its ink stroke. */
.av2 .av2-token[data-kind='story'] .av2-token__face { fill: var(--av2-on-blue); stroke: var(--av2-on-blue); }
.av2 .av2-token[data-kind='reward'] .av2-token__face { fill: var(--av2-on-yellow); stroke: var(--av2-on-yellow); }
.av2 .av2-token[data-kind='action'] .av2-token__face { fill: var(--av2-on-red); stroke: var(--av2-on-red); }
.av2 .av2-token[data-kind='done'] .av2-token__face { fill: var(--av2-on-ink); stroke: var(--av2-on-ink); }
.av2 .av2-token__face circle { stroke: none; }
.av2 .av2-token__mouth {
  fill: none;
  stroke-width: 1.5;
  stroke-linecap: round;
  opacity: 0;
  animation: av2-token-face 0.6s ease-out;
}

/* The grin or frown shows, then settles back to the two eyes. */
@keyframes av2-token-face {
  0% { opacity: 0; }
  15% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .av2 .av2-mark .av2-mark__pop,
  .av2 .av2-token[data-state='active'] { animation: none; }
  .av2 .av2-token__mouth { display: none; animation: none; }
}
/* end WP-D1 / WP-D3 */

/* ====================================================================
/* ===========================================================================
   WP-D2 — the cast reacts; WP-D7 — the tile's mould.
   Append-only block, scoped under `.av2`, `--av2-*` tokens only.
   =========================================================================== */

/* The respond step: the character's line in the design's bubble, their face
   beside it. The face is keyed on its mood, so the verdict's face pops in. */
.av2 .av2-speech { display: flex; align-items: flex-end; gap: 12px; min-width: 0; }
.av2 .av2-speech__face { flex: none; display: inline-flex; }
.av2 .av2-speech:not([data-mood='neutral']) .av2-speech__face { animation: av2-pop 0.3s ease-out; }
.av2 .av2-speech__bubble {
  flex: 1 1 auto;
  min-width: 0;
  padding: 14px 16px;
  border-radius: 20px 20px 20px 6px;
  background: var(--av2-card);
}
.av2 .av2-speech__bubble > .av2-headline { margin: 0; }
/* A long line in the bubble steps down a size, so a reply never fills the screen. */
.av2 .av2-speech__bubble[data-long] > .av2-headline { font-size: calc(var(--av2-t-head) * 0.72); line-height: 1.22; }

/* WP-L10 — the rule card v2. One Garamond line (the French example, intro only);
   the rule in the learner's language; the pattern drawn with the WP-D6 shapes;
   red = the part that carries the rule, grey = written but silent. */
.av2 .rc { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.av2 .rc[data-variant='inline'] { gap: 12px; padding: 14px 16px; border-radius: 16px; background: var(--av2-card); }
.av2 .rc-eyebrow { margin: 0; }
.av2 .rc-source { display: flex; align-items: center; gap: 10px; min-width: 0; }
.av2 .rc-source__name { flex: 1; min-width: 0; font-size: var(--av2-t-label); font-weight: 600; color: var(--av2-muted); }
.av2 .rc-listen {
  flex: none; margin-left: auto; width: 44px; height: 44px; border: 0; border-radius: 999px;
  display: grid; place-items: center; background: var(--av2-card); color: var(--av2-blue); cursor: pointer;
}
.av2 .rc[data-variant='inline'] .rc-listen { background: var(--av2-paper); }
.av2 .rc-listen[aria-busy='true'] { opacity: 0.55; }
.av2 .rc-example { margin: 0; font-size: var(--av2-t-screen); line-height: 1.12; }
.av2 .rc-example--inline { font-size: var(--av2-t-option); font-weight: 600; line-height: 1.3; color: var(--av2-ink); }
/* WP-92: the scene's own line is the card's first anchor — the speaker's face,
   their name, and a tiny «in today's scene» under it; the generic example
   follows in the body face. */
.av2 .rc-scene { display: flex; flex-direction: column; gap: 8px; min-width: 0; padding-bottom: 12px; border-bottom: 1px solid var(--av2-line); }
.av2 .rc-scene__who { display: block; color: var(--av2-ink); }
.av2 .rc-scene__label { display: block; font-weight: 500; color: var(--av2-blue); }
.av2 .rc-mark { color: var(--av2-red); }
.av2 .rc-silent { color: var(--av2-muted); opacity: 0.8; }
.av2 .rc-translate { display: flex; flex-direction: column; gap: 4px; }
.av2 .rc-link {
  align-self: flex-start; min-height: 32px; padding: 0; border: 0; background: transparent; cursor: pointer;
  font: inherit; font-size: var(--av2-t-label); font-weight: 600; color: var(--av2-ink-2);
  text-decoration: underline; text-underline-offset: 3px;
}
.av2 .rc-translation { margin: 0; font-size: var(--av2-t-body); color: var(--av2-ink-2); }
.av2 .rc-rule { margin: 0; font-size: 1.125rem; line-height: 1.35; font-weight: 500; color: var(--av2-ink); }
.av2 .rc-pattern { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px; border-radius: 16px; background: var(--av2-card); }
.av2 .rc[data-variant='inline'] .rc-pattern { background: var(--av2-paper); }
.av2 .rc-row { display: grid; grid-template-columns: 30px minmax(3.2rem, auto) minmax(0, 1fr); align-items: center; column-gap: 10px; }
.av2 .rc-row__label { font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-muted); }
.av2 .rc-row__fr { font-size: var(--av2-t-body-lg); color: var(--av2-ink); min-width: 0; overflow-wrap: anywhere; }
.av2 .rc-row__fr .rc-mark { font-weight: 700; }
.av2 .rc-glyph { flex: none; display: block; width: 30px; height: 22px; fill: var(--av2-blue); }
.av2 .rc-glyph[data-shape='square'] { fill: var(--av2-ink-2); }
.av2 .rc-glyph[data-shape='triangle'] { fill: var(--av2-red); }
.av2 .rc-glyph__back { fill-opacity: 0.55; }
.av2 .rc-table { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-flow: column; grid-template-rows: repeat(3, auto); column-gap: 14px; }
.av2 .rc-table__cell { min-height: 40px; display: flex; align-items: center; gap: 8px; font-size: var(--av2-t-body-lg); color: var(--av2-ink); }
.av2 .rc-table__p { flex: none; min-width: 2.5rem; color: var(--av2-muted); }
.av2 .rc-table__form .rc-mark { font-weight: 700; }
.av2 .rc-note { margin: 0; padding-top: 10px; border-top: 1px solid var(--av2-line); font-size: var(--av2-t-meta); font-weight: 600; color: var(--av2-muted); }
.av2 .rc-contrast { display: flex; flex-direction: column; gap: 8px; }
.av2 .rc-contrast__line { margin: 0; display: flex; align-items: center; gap: 10px; font-size: var(--av2-t-body-lg); }
.av2 .rc-contrast__line[data-tone='wrong'] { color: var(--av2-muted); }
.av2 .rc-contrast__line[data-tone='right'] { font-weight: 600; color: var(--av2-ink); }
.av2 .rc-contrast__badge { flex: none; width: 24px; height: 24px; border-radius: 999px; display: grid; place-items: center; }
.av2 .rc-contrast__line[data-tone='wrong'] .rc-contrast__badge { background: var(--av2-line); color: var(--av2-red); }
.av2 .rc-contrast__line[data-tone='right'] .rc-contrast__badge { background: var(--av2-green); color: var(--av2-card); }
.av2 .rc-why { display: flex; flex-direction: column; gap: 6px; }
.av2 .rc-why__toggle {
  align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 14px;
  border: 0; border-radius: 999px; background: var(--av2-line); color: var(--av2-ink); cursor: pointer;
  font: inherit; font-size: var(--av2-t-label); font-weight: 700;
}
.av2 .rc-more { margin: 0; font-size: var(--av2-t-body); line-height: 1.45; color: var(--av2-ink-2); }
.av2 .rc-cahier { font-weight: 700; color: var(--av2-blue); }
.av2 .rc-done { width: 100%; margin-top: 6px; }

/* «Marin vous sourit ↑» under a correct verdict. */
.av2 .av2-smiles { margin: 0; color: var(--av2-green); }

/* The recap's mood chip: paper on the card it sits in. */
.av2 .av2-reward__mood { margin: 0; }
.av2 .av2-reward__mood .av2-chip { background: var(--av2-paper); color: inherit; }

/* Word tiles: a placed word leaves a dashed mould of its own width; the
   placed tiles wear the selected style (the existing `[data-state='placed']`). */
.av2 .av2-tile--mould {
  border: 2px dashed var(--av2-line-2);
  background: transparent;
  box-shadow: none;
  cursor: default;
}
.av2 .av2-tile__ghost { visibility: hidden; }
.av2 .av2-tiles__line .av2-tile { cursor: default; }
/* end WP-D2 / WP-D7 */

/* ===========================================================================
   WP-D4 · The Seal (components/ui/Seal.tsx), rebuilt in the av2 language.
   A card-face disc on the large press, no ink border, no offset shadow; the
   words around it in Instrument Sans 600, sentence case, --av2-muted; a
   paper well holding the logo's four shapes, filled, each on its *-deep
   press, no strokes anywhere.
   =========================================================================== */

.av2.av2-seal-host {
  display: inline-block;
  background: transparent;
}

.av2 .av2-seal {
  --av2-seal-size: 168px;
  display: inline-grid;
  place-items: center;
  padding-bottom: var(--av2-press-lg);
}
.av2 .av2-seal[data-size='lg'] {
  --av2-seal-size: 216px;
}
/* WP-94: the épreuve's oversized seal — the band just closed. Never wider
   than the column at 320 px. */
.av2 .av2-seal[data-size='xl'] {
  --av2-seal-size: min(264px, 72vw);
}

.av2 .av2-seal__disc {
  position: relative;
  display: grid;
  place-items: center;
  width: var(--av2-seal-size);
  height: var(--av2-seal-size);
  border-radius: 50%;
  background: var(--av2-card);
  box-shadow: 0 var(--av2-press-lg) 0 var(--av2-line-2);
}

.av2 .av2-seal__words {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.av2 .av2-seal__line {
  font-family: var(--av2-sans);
  font-weight: 600;
  font-size: 12.5px;
  letter-spacing: normal;
  text-transform: none;
  fill: var(--av2-muted);
}
.av2 .av2-seal[data-tone='gilt'] .av2-seal__line {
  fill: var(--av2-yellow-deep);
}

.av2 .av2-seal__well {
  position: relative;
  width: 66%;
  height: 66%;
  border-radius: 50%;
  background: var(--av2-paper);
  box-shadow: inset 0 3px 0 var(--av2-line);
}
.av2 .av2-seal__well svg,
.av2 .av2-seal-mini__well svg {
  position: absolute;
  inset: 12%;
  width: 76%;
  height: 76%;
  overflow: visible;
}

.av2 .av2-seal__form {
  stroke: none;
}
.av2 .av2-seal__form--circle { fill: var(--av2-blue); }
.av2 .av2-seal__form--square { fill: var(--av2-yellow); }
.av2 .av2-seal__form--tri { fill: var(--av2-red); }
.av2 .av2-seal__form--block { fill: var(--av2-ink); }
.av2 .av2-seal__form--circle.is-press { fill: var(--av2-blue-deep); }
.av2 .av2-seal__form--square.is-press { fill: var(--av2-yellow-deep); }
.av2 .av2-seal__form--tri.is-press { fill: var(--av2-red-deep); }
.av2 .av2-seal__form--block.is-press { fill: var(--av2-ink-deep); }

/* The press: the disc comes down onto the page once, and its press lands. */
.av2 .av2-seal[data-stamp='true'] .av2-seal__disc {
  animation: av2-seal-press 0.52s cubic-bezier(0.2, 1.2, 0.3, 1) both;
}
@keyframes av2-seal-press {
  0% {
    transform: translateY(-14px) scale(1.06);
    box-shadow: 0 22px 0 var(--av2-line-2);
  }
  62% {
    transform: translateY(3px) scale(0.985);
    box-shadow: 0 5px 0 var(--av2-line-2);
  }
  100% {
    transform: none;
    box-shadow: 0 var(--av2-press-lg) 0 var(--av2-line-2);
  }
}
@media (prefers-reduced-motion: reduce) {
  .av2 .av2-seal[data-stamp='true'] .av2-seal__disc {
    animation: none;
  }
}

/* ---- WP-S7: one ring per rule held today (filled annuli, no stroke) ---- */
.av2 .av2-seal[data-rings] {
  margin: calc(var(--av2-seal-size) * 0.2);
}
.av2 .av2-seal__rings {
  position: absolute;
  left: 50%;
  top: 50%;
  width: calc(var(--av2-seal-size) * 1.4);
  height: calc(var(--av2-seal-size) * 1.4);
  /* the .av2 * max-width cap would squeeze the rings onto the disc */
  max-width: none;
  transform: translate(-50%, -50%);
  overflow: visible;
  pointer-events: none;
}
.av2 .av2-seal__ring {
  fill: var(--av2-yellow);
  stroke: none;
  transform-box: fill-box;
  transform-origin: 50% 50%;
}
@media (prefers-reduced-motion: no-preference) {
  .av2 .av2-seal[data-stamp='true'] .av2-seal__ring {
    animation: av2-pop 0.35s both;
  }
}

/* ---- SealMini: the collection's discs (WP-D5) ---- */
.av2 .av2-seal-mini {
  display: grid;
  justify-items: center;
  gap: 6px;
  min-width: 0;
}
.av2 .av2-seal-mini__disc {
  position: relative;
  display: grid;
  place-items: center;
  width: 100%;
  max-width: 44px;
  aspect-ratio: 1;
  border-radius: 50%;
  background: var(--av2-card);
  box-shadow: 0 var(--av2-press-sm) 0 var(--av2-line-2);
}
.av2 .av2-seal-mini__well {
  position: absolute;
  inset: 8%;
  border-radius: 50%;
  background: var(--av2-paper);
}
.av2 .av2-seal-mini__well svg {
  inset: 10%;
  width: 80%;
  height: 80%;
}
.av2 .av2-seal-mini__token {
  width: 70%;
  height: 70%;
}
.av2 .av2-seal-mini[data-state='missed'] .av2-seal-mini__disc {
  background: var(--av2-line);
  box-shadow: none;
}
.av2 .av2-seal-mini[data-state='relache'] .av2-seal-mini__disc,
.av2 .av2-seal-mini[data-state='today'] .av2-seal-mini__disc,
.av2 .av2-seal-mini[data-state='future'] .av2-seal-mini__disc {
  background: transparent;
  box-shadow: none;
  border: 2px dashed var(--av2-line-2);
}
.av2 .av2-seal-mini[data-state='today'] .av2-seal-mini__disc {
  border-color: var(--av2-red);
}
.av2 .av2-seal-mini[data-state='future'] .av2-seal-mini__disc {
  border-style: dotted;
}
.av2 .av2-seal-mini__no {
  font-family: var(--av2-sans);
  font-size: var(--av2-t-meta);
  font-weight: 600;
  line-height: 1;
  color: var(--av2-muted);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* ---- WP-D5 · «Vos sceaux» (components/releve/SealCollection.tsx) ---- */
.av2 .av2-seals__week-days,
.av2 .av2-seals__grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  column-gap: 4px;
  row-gap: 12px;
  min-width: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}
.av2 .av2-seals__week-days {
  margin-bottom: 8px;
  text-align: center;
}
.av2 .av2-seals__today {
  display: flex;
  align-items: center;
  gap: 12px;
}
.av2 .av2-seals__today .av2-seal-mini {
  flex: 0 0 44px;
}
.av2 .av2-seals__today-body {
  display: grid;
  gap: 2px;
  min-width: 0;
}

/* ---- WP-D4 · the recap's hero ---- */
.av2 .av2-recap__seal {
  display: grid;
  justify-items: center;
  gap: 10px;
  text-align: center;
}

/* ===========================================================================
   WP-89 «Le fil» — the respond step is one conversation (RespondThread.tsx),
   and the connection notice lives in the session header's slot (W6).
   Append-only; `--av2-*` tokens only, both themes; motion is covered by the
   global Reduce Motion rule.
   =========================================================================== */

/* W6: the notice hangs under the head, out of the flow, so it can never push
   the step — or the Send button — down under the thumb. */
.av2 .av2-session__head { position: relative; }
.av2 .av2-session__notice {
  position: absolute;
  top: 100%;
  left: var(--av2-gutter);
  right: var(--av2-gutter);
  z-index: 5;
  margin-top: 6px;
  pointer-events: none;
}
.av2 .av2-session__notice:empty { display: none; }
.av2 .av2-session__notice .av2-notice {
  padding: 8px 12px;
  background: var(--av2-paper);
  font-size: var(--av2-t-label);
  pointer-events: auto;
}

/* The name, then one red triangle per planned exchange: filled once played,
   a ghost of the same shape until then — a sequence, never a ring. */
.av2 .av2-thread__head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; min-width: 0; }
.av2 .av2-thread__tokens { margin: 0; display: inline-flex; align-items: center; gap: 5px; }
.av2 .av2-thread__token { display: inline-flex; }
.av2 .av2-thread__token[data-state='todo'] .av2-shape,
.av2 .av2-thread__token[data-state='active'] .av2-shape { color: var(--av2-line-2); }

.av2 .av2-thread {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}
.av2 .av2-thread__line { min-width: 0; }
/* In a conversation the latest line is still the one headline, a size down so
   the column reads as talk rather than as a title card. */
.av2 .av2-step--thread .av2-speech__bubble:not([data-long]) > .av2-headline {
  font-size: var(--av2-t-title);
  line-height: 1.2;
}

/* Earlier character lines: a smaller bubble that fits its words, xs face. */
.av2 .av2-speech--past { gap: 8px; }
.av2 .av2-speech--past .av2-speech__bubble {
  flex: 0 1 auto;
  padding: 10px 14px;
  border-radius: 16px 16px 16px 6px;
}
.av2 .av2-thread__text { margin: 0; font-size: var(--av2-t-rule); line-height: 1.3; color: var(--av2-ink-2); }

/* The learner's own lines: on the right, Garamond italic, as if typed on the
   page — no bubble, a hairline margin rule. */
.av2 .av2-thread__line[data-speaker='learner'] {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
  padding-left: 12%;
}
.av2 .av2-thread__mine {
  margin: 0;
  padding-right: 12px;
  border-right: 2px solid var(--av2-line-2);
  text-align: right;
  font-size: var(--av2-t-rule);
  line-height: 1.35;
  color: var(--av2-ink);
}
.av2 .av2-thread__mine[data-pending] { color: var(--av2-ink-2); }

/* WP-103 T6. The slip in the learner's line is only marked (a red dotted
   underline, nothing to tap); under the line the corrected form is always
   printed — small green Garamond — and is the control that opens the one-line
   explanation. */
.av2 .av2-thread__slip {
  text-decoration-line: underline;
  text-decoration-style: dotted;
  text-decoration-color: var(--av2-red);
  text-decoration-thickness: 2px;
  text-underline-offset: 5px;
}
.av2 .av2-thread__fix {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  max-width: 100%;
  min-width: 0;
}
.av2 .av2-thread__fixbtn,
.av2 .av2-thread__fixline {
  margin: 0;
  padding: 0 12px 0 0;
  border: 0;
  background: none;
  color: var(--av2-green);
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: var(--av2-t-body-lg);
  line-height: 1.3;
  text-align: right;
}
.av2 .av2-thread__fixbtn {
  min-height: var(--av2-tap);
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0;
  cursor: pointer;
  text-decoration-line: underline;
  text-decoration-style: dotted;
  text-decoration-thickness: 1px;
  text-underline-offset: 5px;
}
.av2 .av2-thread__fixbtn[aria-expanded='true'] { text-decoration-style: solid; }
.av2 .av2-thread__fixbtn:focus-visible { outline: 2px solid var(--av2-focus); outline-offset: 2px; border-radius: 4px; }
.av2 .av2-thread__fixed { font-weight: 500; }
.av2 .av2-thread__note {
  max-width: 100%;
  padding: 10px 12px;
  border-left: 2px solid var(--av2-green);
  border-radius: 0 12px 12px 0;
  background: var(--av2-card);
  color: var(--av2-ink-2);
  font-size: var(--av2-t-label);
  text-align: left;
}
.av2 .av2-thread__note p { margin: 0; }
.av2 .av2-thread__note p + p { margin-top: 4px; }
.av2 .av2-thread__note .av2-correction { margin: 0; padding: 0; background: none; }

/* WP-103 T3. What a drill asks for, right under its instruction: the goal in
   the learner's language (sans, ink, a card of its own), or the scene line the
   item is cut from (Garamond, with its label). */
.av2 .av2-goal {
  margin: 0;
  padding: 12px 14px;
  border-radius: var(--av2-r-card);
  background: var(--av2-card);
  color: var(--av2-ink);
  font-size: var(--av2-t-body-lg);
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.av2 .av2-goal[data-goal='source'] { display: flex; flex-direction: column; gap: 4px; font-weight: 400; }
.av2 .av2-goal[data-goal='source'] .av2-label { margin: 0; }
.av2 .av2-goal__fr { margin: 0; font-size: var(--av2-t-rule); line-height: 1.3; color: var(--av2-ink); }

/* WP-103 T7. Under the latest line, the whole time the field is open: whose
   turn it is, to whom, how far the conversation goes. Sans, quiet, never a
   button; the exchange part is the muted half. */
.av2 .av2-thread__cue {
  margin: 0;
  font-size: var(--av2-t-body);
  font-weight: 600;
  line-height: 1.35;
  color: var(--av2-ink);
}
.av2 .av2-thread__cue-part { font-weight: 600; color: var(--av2-muted); }
.av2 .av2-thread__cue[data-last='true'] .av2-thread__cue-part { color: var(--av2-ink); font-weight: 700; }

/* WP-103 T6. The closing verdict lists the closing turn's corrections: one
   block, one line per issue. */
.av2 .av2-correction__notes { margin: 6px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
/* end WP-89 */

/* ===========================================================================
   WP-94 «Numéro spécial» — the épreuve's edition. Calm and editorial: the La Une
   masthead is double-ruled (two ink hairlines), the kicker says what the
   edition is, the can-dos are one line of text. No new colour, no gauge.
   =========================================================================== */
.av2 .av2-home__mast[data-special] {
  position: relative;
  padding-bottom: 14px;
}
.av2 .av2-home__mast[data-special]::after {
  content: '';
  position: absolute;
  left: var(--av2-gutter);
  right: var(--av2-gutter);
  bottom: 0;
  height: 4px;
  border-top: 1px solid var(--av2-ink);
  border-bottom: 1px solid var(--av2-ink);
  pointer-events: none;
}
.av2 .av2-special__kicker {
  color: var(--av2-ink);
  font-weight: 600;
}
.av2 .av2-special__list {
  margin: 0;
  color: var(--av2-ink);
}

/* The pass: the oversized seal, the band closed, the whole cast in one row. */
.av2 .av2-epreuve__seal { margin: 4px auto 6px; }
.av2 .av2-epreuve__cast {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
  margin: 4px 0 0;
  padding: 0;
  list-style: none;
}
.av2 .av2-epreuve--failed { display: grid; gap: 6px; }

/* ===========================================================================
   WP-95 «Le Carnet» — Cahier → Carnet. Unstamped can-dos are a quiet dotted
   disc; stamped ones are pressed as small seals with the scene, the face, the
   date and the learner's own words.
   =========================================================================== */
.av2 .av2-carnet { display: grid; gap: 14px; min-width: 0; }
.av2 .av2-carnet__lead { margin: 0; color: var(--av2-muted); }
.av2 .av2-carnet__bands {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  scrollbar-width: none;
  margin: 0;
  padding: 2px 0 4px;
  list-style: none;
}
.av2 .av2-carnet__bands::-webkit-scrollbar { display: none; }
.av2 .av2-carnet__band {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: var(--av2-tap);
  padding: 0 14px;
  border: 1px solid var(--av2-line-2);
  border-radius: var(--av2-r-pill);
  background: transparent;
  color: var(--av2-ink);
  font: inherit;
  font-size: var(--av2-t-meta);
  font-weight: 600;
  white-space: nowrap;
  cursor: pointer;
}
.av2 .av2-carnet__band[aria-pressed='true'] { background: var(--av2-ink); color: var(--av2-on-ink); border-color: var(--av2-ink); }
.av2 .av2-carnet__band[data-locked] { color: var(--av2-muted); border-style: dashed; }
.av2 .av2-carnet__band-note { font-weight: 400; opacity: 0.8; }
.av2 .av2-carnet__list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
.av2 .av2-carnet__item {
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr);
  gap: 12px;
  align-items: start;
  padding: 14px;
  border-radius: var(--av2-r-card, 16px);
  background: var(--av2-card);
}
.av2 .av2-carnet__item[data-stamped='false'] { background: transparent; box-shadow: inset 0 0 0 1px var(--av2-line); }
.av2 .av2-carnet__item[data-locked] { opacity: 0.75; }
.av2 .av2-carnet__mark { width: 44px; }
.av2 .av2-carnet__body { display: grid; gap: 4px; min-width: 0; }
.av2 .av2-carnet__title { margin: 0; font-weight: 600; color: var(--av2-ink); }
.av2 .av2-carnet__title-fr { margin: 0; }
.av2 .av2-carnet__stamp { display: flex; align-items: center; gap: 8px; margin: 0; color: var(--av2-muted); font-size: var(--av2-t-meta); }
.av2 .av2-carnet__quote { margin: 0; font-family: var(--av2-serif); font-style: italic; color: var(--av2-ink); }
.av2 .av2-carnet__try { justify-self: start; }
.av2 .av2-carnet__home-link { display: inline-block; padding: 4px 0; color: inherit; text-decoration: underline; text-underline-offset: 3px; }


/* ===========================================================================
   WP-103 — La Forge: the goal, «Je relis…», and the follow-up after «À corriger».
   Tokens only; the primary of the screen stays the footer's.
   =========================================================================== */
.av2 .ep-goal { margin: 0; }

/* T9. The grading character's face and one line, while the model reads. */
.av2 .ep-reading { display: flex; align-items: center; gap: 12px; min-width: 0; }
.av2 .ep-reading__face { flex: none; display: inline-flex; }
.av2 .ep-reading__line {
  margin: 0;
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: var(--av2-t-option);
  line-height: 1.3;
  color: var(--av2-ink);
}
.av2 .ep-reading__skip { align-self: flex-start; }

/* T8. «Corrigez la phrase»: the wrong sentence quoted, a field or tiles, then the right one. */
.av2 .ep-follow {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
  padding: 14px 16px;
  border-radius: var(--av2-r-card);
  background: var(--av2-card);
}
.av2 .ep-follow__title { margin: 0; }
.av2 .ep-follow__goal { margin: 0; color: var(--av2-ink-2); }
.av2 .ep-follow__quote {
  margin: 0;
  padding: 0 0 0 12px;
  border-left: 2px solid var(--av2-line-2);
  font-family: var(--av2-serif);
  font-style: italic;
  font-size: var(--av2-t-option);
  line-height: 1.35;
  color: var(--av2-ink-2);
  overflow-wrap: anywhere;
}
.av2 .ep-follow__input { min-height: 4.5rem; }
.av2 .ep-follow__actions { display: flex; flex-direction: column; gap: 4px; }
.av2 .ep-follow__skip { align-self: center; }
.av2 .ep-follow__answer { display: flex; flex-direction: column; gap: 4px; }
.av2 .ep-follow__answer .av2-label { margin: 0; }
.av2 .ep-follow__fixed {
  margin: 0;
  font-size: var(--av2-t-option);
  line-height: 1.35;
  color: var(--av2-green);
  overflow-wrap: anywhere;
}
.av2 .ep-follow[data-outcome='open'] .ep-follow__quote { color: var(--av2-ink); }
.av2 .ep-follow--line { padding: 12px 14px; }
/* ===========================================================================
   WP-119 · La Revue de Romy (components/revue/*).
   Ported from the mockups' rv-* block (docs/design-reference/revue/*.html).
   Scoped under `.av2`; `--av2-*` tokens only — no new font, no new colour.
   Romy's accent is `--av2-blue` (the same blue as `--char-romy` in both themes).
   =========================================================================== */

/* --- the page ------------------------------------------------------------ */
.av2.rv-page {
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  background: var(--av2-paper);
  width: 100%;
  max-width: var(--phone-shell-max, 460px);
  margin: 0 auto;
}
.av2 .rv-top {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--av2-paper);
  padding-top: calc(env(safe-area-inset-top, 0px) + 10px);
}
.av2 .rv-body { flex: 1 1 auto; display: flex; flex-direction: column; gap: 14px; padding: 14px var(--av2-gutter) 18px; min-width: 0; }
.av2 .rv-foot {
  position: sticky;
  bottom: 0;
  z-index: 9;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px var(--av2-gutter) calc(env(safe-area-inset-bottom, 0px) + 18px);
  border-top: 1px solid var(--av2-line);
  background: var(--av2-paper);
}
.av2 .rv-kicker { margin: 0; font-size: var(--av2-t-meta); font-weight: 700; line-height: 1.3; color: var(--av2-blue); }
.av2 .rv-mock { align-self: flex-start; margin: 0 var(--av2-gutter); font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-muted); }

/* --- RvSessionHead: close · five beats · the column ---------------------- */
.av2 .rv-head { display: flex; align-items: center; gap: 12px; padding: 0 var(--av2-gutter) 10px; }
.av2 .rv-head .av2-icon-btn { flex: none; }
.av2 .rv-head__beats { display: flex; flex: 1 1 auto; gap: 4px; min-width: 0; margin: 0; padding: 0; list-style: none; }
.av2 .rv-head__beats .av2-progress__segment { flex: 1 1 0; height: 10px; border-radius: 5px; }
.av2 .rv-head__beats .av2-progress__segment[data-beat='pursue'] { flex-grow: 2; }

/* --- RvColumn: the remaining room as a newspaper column, never a clock --- */
.av2 .rv-col { position: relative; flex: none; display: inline-flex; align-items: center; gap: 7px; min-height: var(--av2-tap); min-width: var(--av2-tap); padding: 0 2px; border: 0; background: none; color: var(--av2-muted); font: 700 var(--av2-t-meta)/1 var(--av2-sans); cursor: pointer; }
.av2 .rv-col__glyph { display: grid; grid-template-rows: repeat(7, 2px); gap: 2px; width: 16px; flex: none; }
.av2 .rv-col__glyph i { display: block; height: 2px; border-radius: 1px; background: var(--av2-line-2); }
.av2 .rv-col__glyph i:nth-child(odd) { width: 100%; }
.av2 .rv-col__glyph i:nth-child(even) { width: 78%; }
.av2 .rv-col__glyph i[data-used] { background: var(--av2-ink); }
.av2 .rv-col[data-phase='bouclage'], .av2 .rv-col[data-phase='boucle'] { color: var(--av2-ink); }
.av2 .rv-col[data-phase='bouclage'] .rv-col__glyph i[data-last] { background: var(--av2-red); }
.av2 .rv-col__tip { position: absolute; top: 100%; right: 0; z-index: 12; width: max-content; max-width: 240px; margin-top: 4px; padding: 8px 12px; border-radius: 12px; background: var(--av2-ink); color: var(--av2-on-ink); font: 600 var(--av2-t-label)/1.35 var(--av2-sans); text-align: left; }

/* --- RvStage: the plate with the drawn cast ------------------------------ */
.av2 .rv-stage { position: relative; width: 100%; aspect-ratio: 4 / 3; overflow: hidden; background: var(--av2-card); flex: none; }
.av2 .rv-stage[data-size='band'] { aspect-ratio: 390 / 168; border-bottom: 1px solid var(--av2-line); }
.av2 .rv-stage[data-size='une'] { aspect-ratio: 16 / 9; }
.av2 .rv-stage__plate { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.av2 .rv-stage[data-size='band'] .rv-stage__plate { object-position: 50% 62%; }
.av2 .rv-stage[data-size='une'] .rv-stage__plate { object-position: 50% 55%; }
.av2 .rv-stage__fallback { position: absolute; inset: 0; background: repeating-linear-gradient(135deg, var(--av2-line) 0 8px, var(--av2-card) 8px 16px); }
.av2 .rv-stage .cast-stage { z-index: 2; }
.av2 .rv-stage .cast-stage__figure[data-entering] { animation: rv-enter 0.26s ease-out both; }
@keyframes rv-enter { from { transform: translateX(-20%); opacity: 0; } to { transform: translateX(-50%); opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .av2 .rv-stage .cast-stage__figure[data-entering] { animation: none; } }
/* the reader's «sous presse» duotone, reused */
.av2 .rv-stage[data-pending] .rv-stage__plate { filter: grayscale(1) contrast(1.08) brightness(1.06); }
.av2 .rv-stage__ink { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: color-mix(in srgb, var(--av2-blue) 88%, var(--av2-blue-deep)); mix-blend-mode: screen; opacity: 0; }
.av2 .rv-stage[data-pending] .rv-stage__ink { opacity: 1; }
.av2 .rv-stage__folio { position: absolute; left: 12px; bottom: 12px; z-index: 6; display: inline-flex; align-items: center; gap: 7px; max-width: calc(100% - 24px);
  padding: 5px 11px 5px 9px; border-radius: 999px; background: var(--av2-paper); color: var(--av2-ink); font: 700 var(--av2-t-meta)/1.3 var(--av2-sans);
  box-shadow: 0 2px 0 color-mix(in srgb, var(--av2-blue-deep) 40%, transparent); }
.av2 .rv-stage__folio::before { content: ''; width: 8px; height: 8px; flex: none; border-radius: 999px; background: var(--av2-blue); }
.av2 .rv-stage-wrap[data-pinned] { position: sticky; top: var(--rv-top-h, 64px); z-index: 8; }

/* --- the thread ---------------------------------------------------------- */
.av2 .rv-thread { gap: 12px; }
.av2 .rv-thread .av2-speech__bubble > .av2-headline { font-size: var(--av2-t-title); line-height: 1.2; }
.av2 .rv-thread .av2-speech__bubble[data-long] > .av2-headline { font-size: var(--av2-t-option); line-height: 1.3; }
.av2 .rv-narr { margin: 0; font-size: var(--av2-t-body); line-height: 1.5; color: var(--av2-ink-2); }
.av2 .rv-thread__line + .rv-thread__line > .rv-narr { margin-top: -6px; }
.av2 .rv-who { display: block; margin: 0 0 3px; font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-blue); }
.av2 .rv-line__tools { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.av2 .rv-translation { margin: 6px 0 0; font-size: var(--av2-t-body); line-height: 1.4; color: var(--av2-ink-2); }
.av2 .rv-chip { display: inline-flex; align-items: center; gap: 7px; min-height: var(--av2-tap); padding: 4px 12px; border: 0; border-radius: 999px;
  background: var(--av2-paper); color: var(--av2-ink); font: 700 var(--av2-t-meta)/1 var(--av2-sans); cursor: pointer; }
.av2 .rv-claim .rv-chip { background: var(--av2-paper); }
.av2 .rv-chip .sq { width: 8px; height: 8px; border-radius: 2px; background: currentColor; }
.av2 .rv-chip[aria-pressed='true'] { background: var(--av2-ink); color: var(--av2-on-ink); }
.av2 .rv-thread__mine { margin: 0; padding-right: 12px; border-right: 2px solid var(--av2-line-2); text-align: right; font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-rule); line-height: 1.35; color: var(--av2-ink); }
.av2 .rv-thread__mine[data-pending] { color: var(--av2-ink-2); }

/* tap-to-gloss (the reader's fr-word, here) and the printed gloss (A1) */
.av2 .rv-word { display: inline; margin: 0; padding: 0; border: 0; border-bottom: 1px dotted color-mix(in srgb, var(--av2-muted) 60%, transparent); border-radius: 3px;
  background: none; color: inherit; font: inherit; line-height: inherit; text-align: inherit; cursor: pointer; }
.av2 .rv-word[data-target] { border-bottom-color: var(--av2-yellow-deep); }
.av2 .rv-word[data-open] { background: color-mix(in srgb, var(--av2-yellow) 34%, transparent); }
.av2 ruby.rv-gloss { ruby-position: under; }
.av2 ruby.rv-gloss rt { white-space: nowrap; text-align: center; font: 600 normal 0.6875rem/1.2 var(--av2-sans); color: var(--av2-ink-2); letter-spacing: 0; padding-top: 2px; }
.av2 .rv-target { text-decoration: underline; text-decoration-color: var(--av2-yellow); text-decoration-thickness: 3px; text-underline-offset: 3px; }

/* the read-aloud summary: the face is the play button */
.av2 .rv-listen { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 56px; padding: 8px 14px 8px 8px; border: 0; border-radius: var(--av2-r-card);
  background: var(--av2-card); color: var(--av2-ink); font: 600 var(--av2-t-body)/1.3 var(--av2-sans); text-align: left; box-shadow: 0 var(--av2-press-sm) 0 var(--av2-line-2); cursor: pointer; }
.av2 .rv-listen__play { position: relative; flex: none; display: inline-flex; }
.av2 .rv-listen__play::after { content: ''; position: absolute; right: -3px; bottom: -3px; width: 18px; height: 18px; border-radius: 999px; background: var(--av2-ink); box-shadow: 0 0 0 2px var(--av2-card); }
.av2 .rv-listen__play b { position: absolute; right: 2px; bottom: 1px; z-index: 2; width: 0; height: 0; border-left: 7px solid var(--av2-on-ink); border-top: 4.5px solid transparent; border-bottom: 4.5px solid transparent; }
.av2 .rv-listen[aria-pressed='true'] .rv-listen__play b { border: 0; width: 7px; height: 7px; right: 3.5px; bottom: 2.5px; background: var(--av2-on-ink); }
.av2 .rv-listen__meta { display: block; font-size: var(--av2-t-meta); font-weight: 600; color: var(--av2-muted); }
.av2 .rv-listen__wave { margin-left: auto; display: inline-flex; gap: 2px; align-items: center; }
.av2 .rv-listen__wave i { width: 3px; border-radius: 2px; background: var(--av2-line-2); }
.av2 .rv-summary { margin: 8px 0 0; padding: 0 4px; font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-rule); line-height: 1.4; color: var(--av2-ink-2); }

/* RvClaim: fact = solid ink rule; interpretation / forecast = dashed blue rule + attribution */
.av2 .rv-claim { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 13px 15px 12px 17px; border-radius: var(--av2-r-card); background: var(--av2-card); }
.av2 .rv-claim::before { content: ''; position: absolute; left: 0; top: 12px; bottom: 12px; width: 3px; border-radius: 2px; background: var(--av2-ink); }
.av2 .rv-claim[data-kind='interpretation']::before, .av2 .rv-claim[data-kind='forecast']::before { background: repeating-linear-gradient(to bottom, var(--av2-blue) 0 5px, transparent 5px 9px); }
.av2 .rv-claim__kind { display: flex; align-items: center; gap: 7px; margin: 0; font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-muted); }
.av2 .rv-claim[data-kind='interpretation'] .rv-claim__kind, .av2 .rv-claim[data-kind='forecast'] .rv-claim__kind { color: var(--av2-blue); }
.av2 .rv-claim__fr { margin: 0; font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-option); line-height: 1.38; color: var(--av2-ink); }
.av2 .rv-claim__fr[data-band='b1'] { font-size: var(--av2-t-rule); }
.av2 .rv-claim__by { margin: 0; font-size: var(--av2-t-label); line-height: 1.35; color: var(--av2-ink-2); }
.av2 .rv-claims { display: flex; flex-direction: column; gap: 10px; }

/* RvSourceLine */
.av2 .rv-source { display: flex; flex-wrap: wrap; align-items: center; gap: 0 10px; margin: 0; font-size: var(--av2-t-meta); font-weight: 600; color: var(--av2-muted); }
.av2 .rv-source a { display: inline-flex; align-items: center; min-height: var(--av2-tap); color: var(--av2-ink-2); text-underline-offset: 3px; }
.av2 .rv-source button { min-height: var(--av2-tap); padding: 0 2px; border: 0; background: none; color: var(--av2-ink-2); font: inherit; text-decoration: underline dotted; text-underline-offset: 3px; cursor: pointer; }
.av2 .rv-quote { margin: 0; padding: 10px 12px; border-radius: 12px; background: var(--av2-paper); font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-body); line-height: 1.4; color: var(--av2-ink-2); }

/* claims folded once the learner speaks */
.av2 .rv-folded { display: inline-flex; align-items: center; gap: 8px; min-height: var(--av2-tap); padding: 0; border: 0; background: none; color: var(--av2-ink-2); font: 700 var(--av2-t-meta)/1.3 var(--av2-sans); text-align: left; cursor: pointer; }

/* RvUncertainty: what the sources do not say (the outline surface = absence) */
.av2 .rv-unknown { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px; border-radius: var(--av2-r-card); border: 2px dashed var(--av2-line-2); }
.av2 .rv-unknown__k { display: flex; align-items: center; gap: 7px; margin: 0; font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-ink-2); }
.av2 .rv-unknown__k .rv-ring { width: 10px; height: 10px; flex: none; border-radius: 999px; border: 2px solid var(--av2-blue); }
.av2 .rv-unknown__fr { margin: 0; font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-rule); line-height: 1.3; color: var(--av2-ink); }

/* RvShift: a hairline marker in the thread — no modal, no toast, no tint */
.av2 .rv-shift { display: flex; align-items: center; gap: 10px; margin: 2px 0; font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-muted); }
.av2 .rv-shift::before, .av2 .rv-shift::after { content: ''; flex: 1 1 auto; height: 1px; background: var(--av2-line-2); }

/* typing: «Romy cherche dans ses notes ···» */
.av2 .rv-typing { display: flex; align-items: center; gap: 10px; }
.av2 .rv-typing p { margin: 0; display: inline-flex; align-items: center; gap: 8px; color: var(--av2-muted); font-size: var(--av2-t-meta); font-weight: 600; }
.av2 .rv-typing .rv-dots { display: inline-flex; gap: 3px; }
.av2 .rv-typing .rv-dots i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: 0.5; animation: rv-dot 1.2s infinite ease-in-out; }
.av2 .rv-typing .rv-dots i:nth-child(2) { animation-delay: 0.15s; }
.av2 .rv-typing .rv-dots i:nth-child(3) { animation-delay: 0.3s; }
@keyframes rv-dot { 0%, 80%, 100% { opacity: 0.35; } 40% { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .av2 .rv-typing .rv-dots i { animation: none; } }

/* quick replies over the composer */
.av2 .rv-quick { display: flex; flex-wrap: wrap; gap: 8px; }
.av2 .rv-quick .av2-chip { font-weight: 600; }
.av2 .rv-composer { display: flex; align-items: flex-end; gap: 8px; min-width: 0; }
.av2 .rv-composer .av2-field { flex: 1 1 auto; min-width: 0; }
.av2 .rv-composer .av2-field__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.av2 .rv-composer .av2-field__control { min-height: 3rem; resize: none; }

/* RvMakePicker: ChoiceList with a sub-line and Romy's pick */
.av2 .rv-make .av2-choice { flex-wrap: wrap; row-gap: 2px; align-items: flex-start; cursor: pointer; }
.av2 .rv-make .av2-choice .av2-choice__dot { margin-top: 5px; order: -1; }
.av2 .rv-make__t { flex: 1 1 0; min-width: 0; }
.av2 .rv-make__sub { display: block; margin-top: 3px; font: 400 normal var(--av2-t-label)/1.35 var(--av2-sans); color: var(--av2-ink-2); }
.av2 .rv-make__pick { display: inline-flex; align-items: center; gap: 5px; margin-top: 6px; font: 700 normal var(--av2-t-meta)/1 var(--av2-sans); color: var(--av2-blue); }
.av2 .rv-evidence { margin: 3px 0 0; font-size: var(--av2-t-label); line-height: 1.4; color: var(--av2-ink-2); }
.av2 .rv-evidence q { font-family: var(--av2-serif); font-style: italic; quotes: '« ' ' »'; }

/* RvContribution: the learner's own words, kept (yellow = reward) + a word, never colour alone */
.av2 .rv-yours { background: linear-gradient(transparent 62%, color-mix(in srgb, var(--av2-yellow) 70%, transparent) 62%); padding: 0 1px; }
.av2 .rv-yours sup { font: 700 normal 0.625rem/1 var(--av2-sans); color: var(--av2-muted); margin-left: 2px; }

/* RvQuestionDraft */
.av2 .rv-draft { display: flex; flex-direction: column; gap: 10px; }
.av2 .rv-draft__pane { padding: 12px 14px; border-radius: var(--av2-r-card); background: var(--av2-card); }
.av2 .rv-draft__pane[data-who='you'] { background: transparent; border: 2px solid var(--av2-line); }
.av2 .rv-draft__fr { margin: 4px 0 0; font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-option); line-height: 1.3; color: var(--av2-ink); }
.av2 .rv-draft__why { margin: 8px 0 0; font-size: var(--av2-t-label); line-height: 1.4; color: var(--av2-ink-2); }
.av2 .rv-made { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border-radius: var(--av2-r-card); border: 2px solid var(--av2-line); }
.av2 .rv-made__fr { margin: 0; font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-option); line-height: 1.3; color: var(--av2-ink); }

/* RvDispatch: the clipping that closes the Revue */
.av2 .rv-dispatch { display: flex; flex-direction: column; gap: 10px; padding: 18px 18px 16px; border-radius: var(--av2-r-hero); background: var(--av2-card); }
.av2 .rv-dispatch__rule { height: 4px; border-top: 1px solid var(--av2-ink); border-bottom: 1px solid var(--av2-ink); }
.av2 .rv-dispatch__hl { margin: 0; font-family: var(--av2-serif); font-style: italic; font-weight: 600; font-size: var(--av2-t-head); line-height: 1.1; color: var(--av2-ink); }
.av2 .rv-dispatch__body { margin: 0; font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-rule); line-height: 1.4; color: var(--av2-ink-2); }
.av2 .rv-dispatch__by { margin: 0; display: flex; align-items: center; gap: 8px; font-size: var(--av2-t-label); color: var(--av2-ink-2); }
.av2 .rv-colophon { margin: 4px 0 0; padding-top: 12px; border-top: 1px solid var(--av2-line-2); text-align: center; font: italic var(--av2-t-rule)/1.3 var(--av2-serif); color: var(--av2-ink-2); }
.av2 .rv-kept { display: flex; flex-direction: column; gap: 10px; }
.av2 .rv-kept__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.av2 .rv-kept__t { margin: 0; font: italic 500 var(--av2-t-title)/1.1 var(--av2-serif); color: var(--av2-ink); }
.av2 .rv-kept__n { font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-muted); }
.av2 .rv-kept__rows { display: flex; flex-direction: column; margin: 0; padding: 12px 16px; list-style: none; border-radius: var(--av2-r-card); background: var(--av2-card); }
.av2 .rv-kept__row { display: flex; align-items: center; gap: 12px; padding: 9px 0; border-top: 1px solid var(--av2-line); }
.av2 .rv-kept__row:first-child { border-top: 0; padding-top: 0; }
.av2 .rv-kept__row:last-child { padding-bottom: 0; }
.av2 .rv-kept__fr { flex: 1 1 auto; min-width: 0; font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-rule); color: var(--av2-ink); }
.av2 .rv-kept__de { flex: none; font-size: var(--av2-t-label); color: var(--av2-muted); }
.av2 .rv-ended { margin: 0; font-size: var(--av2-t-label); font-weight: 700; color: var(--av2-ink-2); }

/* --- La Une card (RvUneCard) and the chooser ----------------------------- */
.av2 .rv-une { display: block; overflow: hidden; border-radius: var(--av2-r-hero); background: var(--av2-card); color: inherit; }
.av2 .rv-une__body { display: flex; flex-direction: column; gap: 6px; padding: 14px 18px 16px; }
.av2 .rv-une__folio { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.av2 .rv-une__folio .av2-label { margin: 0; }
.av2 .rv-une__title { margin: 0; font-family: var(--av2-serif); font-style: italic; font-weight: 600; font-size: var(--av2-t-title); line-height: 1.12; color: var(--av2-ink); }
.av2 .rv-une__meta { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: var(--av2-t-label); color: var(--av2-ink-2); }
.av2 .rv-une__meta .rv-dot { width: 3px; height: 3px; border-radius: 999px; background: var(--av2-muted); }
.av2 .rv-une__other { align-self: flex-start; margin-left: -0.75rem; }
.av2 .rv-une__press { margin-top: 14px; }
.av2 .rv-une__filed { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; }
.av2 .rv-une__filed-k { display: flex; align-items: center; gap: 8px; margin: 0; font-size: var(--av2-t-meta); font-weight: 700; color: var(--av2-ink-2); }
.av2 .rv-une__filed-hl { margin: 0; font-family: var(--av2-serif); font-style: italic; font-weight: 600; font-size: var(--av2-t-option); line-height: 1.25; color: var(--av2-ink); }
.av2 .rv-une__colophon { margin: 0; font: italic var(--av2-t-body)/1.3 var(--av2-serif); color: var(--av2-ink-2); }
.av2 .rv-alts { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--av2-line); }
.av2 .rv-alt { display: flex; align-items: center; gap: 12px; width: 100%; min-height: var(--av2-tap); padding: 10px 0; border: 0; border-bottom: 1px solid var(--av2-line); background: none; color: inherit; text-align: left; font: inherit; cursor: pointer; }
.av2 .rv-alt__t { flex: 1 1 auto; min-width: 0; font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-rule); line-height: 1.2; color: var(--av2-ink); }
.av2 .rv-alt__m { display: block; margin-top: 2px; font: 600 normal var(--av2-t-meta)/1.3 var(--av2-sans); color: var(--av2-muted); }
.av2 .rv-ask { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
.av2 .rv-ask input.av2-field__control { min-height: var(--av2-tap); padding: 0.5rem 0.9rem; background: var(--av2-card); }
.av2 .av2-sheet .rv-ask input.av2-field__control { background: var(--av2-card); }
.av2 .rv-ask__mine { margin: 0; align-self: flex-end; padding-right: 12px; border-right: 2px solid var(--av2-line-2); font-family: var(--av2-serif); font-style: italic; font-size: var(--av2-t-rule); color: var(--av2-ink); }
.av2 .rv-sheet { display: flex; flex-direction: column; gap: 12px; }
.av2 .rv-chooser { display: flex; flex-direction: column; gap: 14px; }

/* --- states --------------------------------------------------------------- */
.av2 .rv-loading { display: flex; flex-direction: column; gap: 12px; }
.av2 .rv-loading .rv-stage { aspect-ratio: 4 / 3; }
.av2 .rv-nb { white-space: nowrap; }
.av2 .rv-encounter { flex: 1 1 auto; display: flex; flex-direction: column; min-width: 0; }
.av2 .rv-mock { position: fixed; left: 50%; top: 0; transform: translateX(-50%); z-index: 20; margin: 0; pointer-events: none; opacity: 0.7; font-size: 0.6875rem; }
.av2 .rv-make .av2-choice__dot { width: 18px; height: 18px; box-shadow: inset 0 0 0 2px var(--av2-ink); }
.av2 .rv-make .av2-choice[data-state='selected'] .av2-choice__dot { box-shadow: none; }

/* --- WP-120 · RvVignette: the stamp brought back from a Papier ------------
   An authored frame around the dossier's pictogram. The ring is ink, blue or red
   by what the learner made (headline · reader question · short report); the kept
   mark is the reward yellow. The face is the paper ink in both themes: the
   pictogram is printed in the seven inks, so it is shown on the paper it was
   printed for (a print stays a print in dark mode, like the plates). ---------- */
.av2 .rv-vignette { --rv-vignette-paper: #f1ece1; display: inline-flex; flex-direction: column; align-items: center; gap: 6px; margin: 0; min-width: 0; }
.av2 .rv-vignette__stamp { display: block; flex: none; overflow: visible; }
.av2 .rv-vignette__band { fill: var(--av2-ink); }
.av2 .rv-vignette__inner { stroke: var(--av2-ink); stroke-width: 1; }
.av2 .rv-vignette__week { fill: var(--av2-on-ink); font-family: var(--av2-sans); font-weight: 700; letter-spacing: 0.08em; }
.av2 .rv-vignette[data-ring='question'] .rv-vignette__band { fill: var(--av2-blue); }
.av2 .rv-vignette[data-ring='question'] .rv-vignette__inner { stroke: var(--av2-blue); }
.av2 .rv-vignette[data-ring='question'] .rv-vignette__week { fill: var(--av2-on-blue); }
.av2 .rv-vignette[data-ring='report'] .rv-vignette__band { fill: var(--av2-red); }
.av2 .rv-vignette[data-ring='report'] .rv-vignette__inner { stroke: var(--av2-red); }
.av2 .rv-vignette[data-ring='report'] .rv-vignette__week { fill: var(--av2-on-red); }
.av2 .rv-vignette__face { fill: var(--rv-vignette-paper); }
.av2 .rv-vignette--large .rv-vignette__week { font-size: 11px; }
.av2 .rv-vignette--seal .rv-vignette__week { font-size: 13px; letter-spacing: 0; }
.av2 .rv-vignette__kept { fill: var(--av2-yellow); stroke: var(--rv-vignette-paper); stroke-width: 1.5; }
.av2 .rv-vignette__place { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--av2-serif); font-style: italic; line-height: 1.2; color: var(--av2-ink-2); text-align: center; }
.av2 .rv-vignette--seal .rv-vignette__place { max-width: 88px; font-size: var(--av2-t-meta); }
.av2 .rv-vignette--large .rv-vignette__place { max-width: 220px; font-size: var(--av2-t-body); white-space: normal; }
.av2 .rv-vignette--stamping .rv-vignette__stamp { animation: rv-stamp 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both; transform-origin: 50% 50%; }
@keyframes rv-stamp {
  0% { transform: scale(1.35) rotate(-8deg); opacity: 0; }
  70% { transform: scale(0.96) rotate(1deg); opacity: 1; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) { .av2 .rv-vignette--stamping .rv-vignette__stamp { animation: none; } }

body{margin:0;background:#f1ece1}
.sheet{padding:28px 32px;width:1180px}
h1{font-family:var(--av2-serif);font-style:italic;font-weight:600;font-size:30px;margin:0 0 4px;color:var(--av2-ink)}
.sub{font-family:var(--av2-sans);font-size:13px;color:var(--av2-muted);margin:0 0 20px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px 18px}
.cell{display:flex;flex-direction:column;align-items:center;gap:8px;background:var(--av2-card);border-radius:16px;padding:16px 10px 12px}
.small{display:flex;align-items:center;gap:14px}
.meta{font-family:var(--av2-sans);font-size:11.5px;color:var(--av2-ink-2);text-align:center;margin:0;line-height:1.35}
.fbrow{display:flex;gap:18px;margin-top:10px}
h2{font-family:var(--av2-sans);font-size:13px;color:var(--av2-ink);margin:26px 0 0}
</style></head><body><div class="av2 sheet">
<h1>Les vignettes · douze Papiers evergreen</h1>
<p class="sub">WP-120 phase B · pictograms drawn by the model in the house grammar (pictogram-v1), composed in RvVignette at 160 / 64 / 28 px. Rings rotate ink · blue · red; the yellow mark = contribution kept. Spent US$0.0343.</p>

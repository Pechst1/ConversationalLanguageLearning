# Production environment template — copy to .env.prod next to the repo root
# (docker/docker-compose.prod.yml reads ../.env.prod) and fill every <...>.
#
# Canonical recipe (WP-138): render.yaml is the reference deployment. This file
# carries the same values for the Docker Compose path, so the two never
# disagree; change both together. docs/production-hardening.md §Configuration
# lists what each path needs from the operator.
#
# The API refuses to boot with APP_ENV=production unless:
#   AUTO_CREATE_USERS_ON_LOGIN=false, PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=false,
#   ATELIER_TEST_CLOCK_ENABLED is not true, SMTP_HOST + SMTP_FROM_EMAIL are set,
#   and ATELIER_DAILY_JOURNEY_COHORT is not blank while the journey is enabled.

# --- Application ---
APP_ENV=production
BOOTSTRAP_REFERENCE_DATA=1
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-a-long-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTO_CREATE_USERS_ON_LOGIN=false
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Optional. Password reset emails a six-digit code typed in the app; the email
# adds a link only when this is a public https URL of a hosted web reset page
# (the API host does not serve it). Leave unset while there is no public web app.
# PASSWORD_RESET_BASE_URL=https://<your-web-reset-page-domain>/auth/forgot-password
# Two uvicorn workers fit 512 MB; raise with the machine.
WEB_CONCURRENCY=2

# --- Private pilot access (WP-138) ---
# Sign-up closed: only these emails (comma-separated, case-insensitive) can
# create an account. Existing accounts always sign in. Put the owner first.
REGISTRATION_OPEN=false
REGISTRATION_ALLOWED_EMAILS=<owner@example.com>
# The privacy policy's and the terms' contact (required in production).
LEGAL_CONTACT_EMAIL=<owner@example.com>
# The V2 daily journey and WHO gets it. Not an invite gate (see above).
# Comma-separated emails or user ids; '*' = everyone, 'none' = nobody on
# purpose. Blank refuses to boot in production.
ATELIER_DAILY_JOURNEY_ENABLED=true
ATELIER_DAILY_JOURNEY_COHORT=<owner@example.com>

# --- Mail (required with APP_ENV=production; any SMTP relay works) ---
SMTP_HOST=<smtp.your-provider.com>
SMTP_PORT=587
SMTP_USERNAME=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_EMAIL=<no-reply@your-domain>
SMTP_USE_TLS=true

# --- URLs / CORS ---
API_URL=https://<your-api-domain>
# capacitor://localhost is the native iOS app's origin — it must stay listed.
# Add a web origin only once a public web app exists.
BACKEND_CORS_ORIGINS=["capacitor://localhost","ionic://localhost"]
# Proxies in front of the API (one TLS proxy such as Caddy = 1, as on Render).
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# --- Observability ---
LOG_FORMAT=json
# Sentry stays off until a DSN is set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
WORKER_HEARTBEAT_STALE_SECONDS=300

# --- Database & Redis ---
# In the docker-compose stack these hostnames are the service names.
# POSTGRES_PASSWORD is also read by the db service itself — keep them in sync.
POSTGRES_PASSWORD=<generate-a-db-password>
DATABASE_URL=postgresql+psycopg2://postgres:<generate-a-db-password>@db:5432/language_learning
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- AI providers (copy values from your local .env) ---
OPENAI_API_KEY=<required — serial/feuilleton/atelier generation>
# Optional secondary provider.
ANTHROPIC_API_KEY=
PRIMARY_LLM_PROVIDER=openai
SECONDARY_LLM_PROVIDER=anthropic
OPENAI_MODEL=gpt-5-mini
OPENAI_ERROR_DETECTION_MODEL=gpt-5-mini
OPENAI_GRAPHIC_NOVEL_SCRIPT_MODEL=gpt-5.4-mini
OPENAI_GRAPHIC_NOVEL_PREMIUM_SCRIPT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_TIMEOUT_SECONDS=240
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
ATELIER_LLM_ENABLED=true
# Séance correction (2026-09-07): pinned so the most-used paid call is visible.
ATELIER_CORRECTION_LLM_MODEL=gpt-5-mini
ATELIER_CORRECTION_LLM_MAX_TOKENS=5000
ATELIER_CORRECTION_LLM_TIMEOUT_SECONDS=60
ATELIER_CORRECTION_LLM_REASONING_EFFORT=low

# --- Spend bounds (per learner; 0 switches a bound off) ---
# Paid routes answer 429 daily_budget_reached past this per local day.
USER_DAILY_SPEND_CAP_USD=0.50
# Weekly per-learner warning on the admin dashboard; the journey prefetch
# also skips a learner who reached it.
PILOT_SERIAL_WEEKLY_COST_GUARDRAIL_USD=2.00
# Panel art has its own daily allowance, apart from the cap above.
ATELIER_PANEL_ART_DAILY_ALLOWANCE_USD=0.25

# --- Feuilleton / Serial / season ---
SERIAL_WORLD_ENABLED=true
SERIAL_PHONE_CALL_MISSIONS_ENABLED=false
ATELIER_SEASON_SCRIPT=s1
ATELIER_EPISODE_AUDIO_ENABLED=true
FEUILLETON_AUDIO_TTS_MODEL=gpt-4o-mini-tts
GRAPHIC_NOVEL_DEFAULT_PANEL_COUNT=6
GRAPHIC_NOVEL_IMAGE_CONCURRENCY=3
# Keep generated scene images off until durable storage and the per-panel cost
# have both been confirmed.
GRAPHIC_NOVEL_IMAGE_GENERATION_ENABLED=false
GRAPHIC_NOVEL_IMAGE_COST_USD_PER_PANEL=0.053
# Panel art for A1–A2. It stays off (startup logs why) until durable storage
# is configured below: a drawing on the container's disk dies at redeploy.
ATELIER_PANEL_ART_ENABLED=true
ATELIER_PANEL_ART_BANDS=A1,A2

# --- Durable artwork storage (S3-compatible; required for panel art) ---
# Account deletion removes a learner's scene artwork from here (WP-138).
# GRAPHIC_NOVEL_IMAGE_STORAGE=s3
# GRAPHIC_NOVEL_IMAGE_S3_BUCKET=<bucket>
# GRAPHIC_NOVEL_IMAGE_S3_REGION=<region>
# GRAPHIC_NOVEL_IMAGE_S3_ENDPOINT_URL=<https://s3-compatible-endpoint, blank for AWS>
# GRAPHIC_NOVEL_IMAGE_S3_ACCESS_KEY_ID=<key-id>
# GRAPHIC_NOVEL_IMAGE_S3_SECRET_ACCESS_KEY=<secret>
# GRAPHIC_NOVEL_IMAGE_S3_PUBLIC_BASE_URL=<https://public-base-url-of-the-bucket>

# --- Push notifications ---
# Browser Web Push (optional for the native-only first test)
VAPID_SUBJECT=mailto:<your-admin-email>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# iPhone/APNs. Create one Apple Push Notifications .p8 key in the Developer
# portal. APNS_PRIVATE_KEY accepts the complete PEM with literal \\n newlines.
APNS_TEAM_ID=<apple-team-id>
APNS_KEY_ID=<apple-push-key-id>
APNS_PRIVATE_KEY=<-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY----->
APNS_BUNDLE_ID=com.pixellab.feuilleton
# false = production APNs, for TestFlight/App Store builds (the release
# default). true only while testing a direct Xcode device build.
APNS_USE_SANDBOX=false

# --- NLP ---
FRENCH_NLP_MODEL=fr_core_news_sm

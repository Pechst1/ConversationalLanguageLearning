default_platform(:ios)

def connect_api_key
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_content = ENV["APP_STORE_CONNECT_KEY_CONTENT"]
  return nil unless key_id && issuer_id && key_content

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64", "true") == "true",
    in_house: false
  )
end

platform :ios do
  desc "Build a signed App Store archive without uploading it"
  lane :archive do
    build_number = ENV["CI_BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M")
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: build_number
    )
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build/testflight",
      output_name: "Feuilleton.ipa"
    )
  end

  desc "Archive and upload an internal TestFlight build"
  lane :beta do
    archive
    upload_to_testflight(
      api_key: connect_api_key,
      app_identifier: "com.pixellab.feuilleton",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Private pilot build"
    )
  end
end

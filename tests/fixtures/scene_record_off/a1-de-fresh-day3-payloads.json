     "rule_card": {
      "contrast": {
       "right": "[Il y a] un café ici.",
       "wrong": "Il est un café ici."
      },
      "contrast_with": [
       {
        "id": "FR2_A12_CEST_IL_EST",
        "note": {
         "de": "Il y a stellt etwas Neues vor; c'est zeigt darauf oder kommentiert es: Il y a un café. C'est un bon café.",
         "en": "Il y a presents something new; c'est points at it or comments on it: Il y a un café. C'est un bon café.",
         "fr": "Il y a présente une chose nouvelle ; c'est la montre ou la commente : Il y a un café. C'est un bon café."
        },
        "title": {
         "de": "C'est oder il/elle est",
         "en": "C'est vs il/elle est",
         "fr": "C'est ou il/elle est"
        }
       },
       {
        "id": "FR2_A11_NEGATION",
        "note": {
         "de": "Die Verneinung il n'y a pas de folgt der Regel pas de.",
         "en": "The negative il n'y a pas de follows the pas de rule.",
         "fr": "Il n'y a pas de suit la règle de pas de."
        },
        "title": {
         "de": "Ne…pas und pas de",
         "en": "Ne…pas, and pas de",
         "fr": "Ne…pas et pas de"
        }
       }
      ],
      "example": {
       "fr": "Dans la rue, [il y a] une boulangerie et deux cafés."
      },
      "examples": [
       {
        "fr": "[Il y a] une pharmacie près d'ici ?",
        "tr": {
         "de": "Gibt es hier in der Nähe eine Apotheke?",
         "en": "Is there a pharmacy near here?"
        }
       },
       {
        "fr": "[Il n'y a pas de] lait dans le frigo.",
        "tr": {
         "de": "Im Kühlschrank ist keine Milch.",
         "en": "There's no milk in the fridge."
        }
       },
       {
        "fr": "Ce soir, [il y a] des amis à la maison.",
        "tr": {
         "de": "Heute Abend sind Freunde bei uns.",
         "en": "Tonight there are friends at our place."
        }
       }
      ],
      "from_scene": true,
      "how": {
       "de": "1. Beginne mit il y a: immer dieselben drei Wörter.\n2. Dann un, une, des oder eine Zahl, dann das Nomen.\n3. Verneint: il n'y a pas de + Nomen.",
       "en": "1. Start with il y a: always the same three words.\n2. Add un, une, des or a number, then the noun.\n3. Negative: il n'y a pas de + noun.",
       "fr": "1. Commencez par il y a : toujours les mêmes trois mots.\n2. Ajoutez un, une, des ou un nombre, puis le nom.\n3. À la forme négative : il n'y a pas de + nom."
      },
      "more": {
       "de": "Es bleibt gleich, für eins wie für viele: il y a un café, il y a dix cafés. Verneint werden un, une, des zu de: il n'y a pas de café. Fragen kann man mit Il y a… ? oder Est-ce qu'il y a… ?",
       "en": "It is the same for one thing and for many: il y a un café, il y a dix cafés. In the negative, un, une, des become de: il n'y a pas de café. To ask, say Il y a… ? or Est-ce qu'il y a… ?",
       "fr": "C'est pareil pour une chose ou pour plusieurs : il y a un café, il y a dix cafés. À la forme négative, un, une, des deviennent de : il n'y a pas de café. Pour demander : Il y a… ? ou Est-ce qu'il y a… ?"
      },
      "pattern": {
       "kind": "rows",
       "rows": [
        {
         "fr": "[il y a] un café",
         "label": "+ un, une",
         "shape": "none"
        },
        {
         "fr": "[il y a] des cafés",
         "label": "+ des",
         "shape": "none"
        },
        {
         "fr": "[il y a] deux cafés",
         "label": "+ nombre",
         "shape": "none"
        },
        {
         "fr": "[il n'y a pas de] café",
         "label": "non",
         "shape": "none"
        }
       ]
      },
      "rule": {
       "de": "Il y a heißt „es gibt“ oder „da ist / da sind“ und ändert sich nie.",
       "en": "Il y a means 'there is' and 'there are'; it never changes.",
       "fr": "Il y a présente ce qui existe ; la forme ne change jamais."
      },
      "speaker": "romy_tremblay",
      "traps": [
       {
        "right": "[Il y a] deux cafés.",
        "why": {
         "de": "Il y a bleibt im Singular, auch vor einem Plural.",
         "en": "Il y a stays singular, even before a plural.",
         "fr": "Il y a reste au singulier, même devant un pluriel."
        },
        "wrong": "Il y ont deux cafés."
       },
       {
        "right": "Il n'y a pas [de] pain.",
        "why": {
         "de": "Nach pas werden du, de la und des zu de.",
         "en": "After pas, du, de la and des become de.",
         "fr": "Après pas, du, de la et des deviennent de."
        },
        "wrong": "Il n'y a pas du pain."
       }
      ]
     },

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "API_URL=http://localhost:8010 NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1 npm run dev --prefix web-frontend"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--host", "127.0.0.1", "--port", "8010", "--timeout-keep-alive", "75"],
      "port": 8010
    }
  ]
}

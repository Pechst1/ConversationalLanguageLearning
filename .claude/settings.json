{
  "permissions": {
    "allow": [
      "Bash(python scripts/loop/loop_queue.py merge-ready:*)",
      "Bash(python3 scripts/loop/loop_queue.py merge-ready:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/loop/session_start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
